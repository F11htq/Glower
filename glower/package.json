{
  "name": "glower-os",
  "version": "1.0.1200",
  "private": true,
  "description": "GlowerOS: рабочий стол на Rust (panel), свой оконный сервер (wm) и агент системы на Node",
  "scripts": {
    "start": "node agent/server.mjs",
    "system": "node agent/server.mjs --system --allow-open",
    "session": "sh linux/glower-session",
    "install-linux": "sudo sh linux/install.sh",
    "test": "node test/linux.mjs",
    "test:linux": "node test/linux.mjs"
  }
}
