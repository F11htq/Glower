#!/bin/sh
# ==========================================================================
#  врач — одна короткая команда вместо десятка длинных
#
#  Человеку, у которого что-то сломалось, приходилось вручную набирать
#  простыни из curl, grep и systemd-analyze — на ноутбуке, глядя в телефон.
#  Это не диагностика, а издевательство: пока перепишешь, успеешь сделать
#  три опечатки.
#
#  Здесь собрано всё, что обычно спрашивают, и сжато так, чтобы помещалось
#  на один экран и читалось со снимка.
#
#  Имена переменных латиницей: dash кириллических не понимает.
# ==========================================================================
PORT="${GLOWER_PORT:-8123}"
LOG="${GLOWER_LOG:-/var/log/glower-session.log}"
[ -r "$LOG" ] || LOG="$HOME/glower-session.log"

echo "=== GlowerOS ==="
printf 'версия:   '
cat /etc/glower-release 2>/dev/null || echo '(не записана)'
printf 'сеанс:    %s · %s\n' "${XDG_SESSION_TYPE:-?}" "${XDG_CURRENT_DESKTOP:-?}"

echo
echo "=== загрузка ==="
systemd-analyze 2>/dev/null | head -2 || echo '(нет systemd-analyze)'
systemd-analyze blame 2>/dev/null | head -5 | sed 's/^/  /'

echo
echo "=== что работает ==="
# Ищем по имени, но своих родителей из ответа вычитаем. pgrep находит и ту оболочку, из
# которой врача запустили: её строка запуска содержит слово «врач», а
# вместе с ним — и весь разбираемый список. Собираем цепочку родителей и
# выкидываем её.
ancestors=' '
p=$$
while [ "${p:-1}" -gt 1 ]; do
  ancestors="$ancestors$p "
  p=$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null)
done

alive() {
  n=0
  for pid in $(pgrep -f -- "$1" 2>/dev/null); do
    case "$ancestors" in *" $pid "*) continue ;; esac
    n=$((n + 1))
  done
  [ "$n" -gt 0 ]
}

# Имя, а не полный путь: сперва я написал сюда /usr/bin/glower-shell — и на
# стенде, где та же оболочка запущена из рабочей папки, врач уверенно
# доложил, что её нет. Диагностика, которая врёт на живой системе, хуже
# отсутствующей.
for pair in 'оболочка:glower-shell' \
            'агент:agent/server.mjs' \
            'лоток:glower-tray' \
            'оконный сервер:labwc'; do
  label=${pair%%:*}
  # Состояние — слева и одинаковой ширины. Выравнивать по %-18s нельзя:
  # printf в dash считает байты, а кириллическая буква весит два, и колонка
  # разъезжается ровно на длинных названиях вроде «оконный сервер».
  if alive "${pair#*:}"; then printf '  [ да  ]  %s\n' "$label"
  else                       printf '  [ НЕТ ]  %s\n' "$label"; fi
done

echo
echo "=== панель ==="
busy=$(curl -s --max-time 3 -X POST "http://localhost:$PORT/rpc" \
        -H 'Content-Type: application/json' \
        -d '{"method":"ui.last","params":{"тема":"стол-занят"}}' 2>/dev/null)
case "$busy" in
  *'"что":true'*)  echo '  стол говорит: ЗАНЯТ — панель прячется намеренно' ;;
  *'"что":false'*) echo '  стол говорит: свободен — панель должна быть видна' ;;
  *'"что":null'*)  echo '  стол молчит — он либо не запущен, либо не дошёл до шины' ;;
  '')              echo '  агент не отвечает на порту '"$PORT" ;;
  *)               echo "  стол молчит: $busy" ;;
esac

# Панель — не отдельная программа, а вторая поверхность внутри оболочки,
# и в списке процессов её не видно. Зато видно, с какими настройками
# запущена оболочка и что она сама написала про панель в журнал. Именно
# этого не хватило, когда панель пропала целиком.
pid=$(pgrep -f /usr/bin/glower-shell 2>/dev/null | head -1)
if [ -n "$pid" ] && [ -r "/proc/$pid/environ" ]; then
  tr '\0' '\n' < "/proc/$pid/environ" \
    | grep -E '^GLOWER_(SURFACE|PANEL_H|TOP_H)=' | sed 's/^/  /'
fi
if [ -r "$LOG" ]; then
  grep -i 'панел' "$LOG" 2>/dev/null | tail -3 | cut -c1-96 | sed 's/^/  /'
fi

# Куда стол пускает развёрнутые окна. Число видно сразу: если «top» не
# совпал с ростом полосы, заголовок программы окажется под ней.
area=$(curl -s --max-time 3 -X POST "http://localhost:$PORT/rpc" \
        -H 'Content-Type: application/json' \
        -d '{"method":"ui.last","params":{"тема":"рабочая-область"}}' 2>/dev/null)
case "$area" in
  *'"что":{'*) echo "  место для окон: $(echo "$area" | sed 's/.*"что"://; s/}.*/}/' | cut -c1-70)" ;;
esac

echo
echo "=== Bluetooth ==="
bt=$(curl -s --max-time 4 -X POST "http://localhost:$PORT/rpc" \
      -H 'Content-Type: application/json' \
      -d '{"method":"sys.bt.почему","params":{}}' 2>/dev/null)
case "$bt" in
  *'"словами"'*) echo "  $(echo "$bt" | sed 's/.*"словами":"//; s/".*//')" ;;
  *)             echo '  агент не ответил' ;;
esac
case "$bt" in
  *'"железо":"'*) echo "  железо: $(echo "$bt" | sed 's/.*"железо":"//; s/".*//' | cut -c1-70)" ;;
esac

echo
echo "=== последние жалобы в журнале ==="
if [ -r "$LOG" ]; then
  grep -iE 'ошиб|error|упал|не удалось|traceback' "$LOG" 2>/dev/null \
    | tail -8 | cut -c1-96 | sed 's/^/  /'
  [ -s "$LOG" ] || echo '  (журнал пуст)'
else
  echo "  журнала нет: $LOG"
fi

echo
echo "Показать целиком:  less $LOG"
