#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Оболочка GlowerOS: рабочий стол и панель задач как настоящие поверхности.

Раньше оболочка была окном браузера, притворявшимся рабочим столом: её
приходилось держать в самом низу стопки, а развёрнутая программа накрывала
панель задач, и человеку оставалось угадывать, как вернуться.

Здесь всё честно. Рабочий стол — поверхность нижнего слоя: она под всеми
окнами и никогда с ними не спорит. Полосу под панель задач держит вторая
поверхность, верхнего слоя: она прозрачна и щелчков не ловит — её работа в
том, чтобы оконный сервер вычел эту полосу из рабочей области. Ни одно окно,
даже развёрнутое во весь экран, панель после этого не закроет, а видна она
всё так же на рабочем столе.

Показывает обе поверхности движок WebKit — тот же, что и в настоящих
программах системы; наша оболочка написана обычным HTML и CSS.
"""
import glob
import json
import os
import sys
import urllib.request
import ctypes

import cairo

# Без настоящей видеокарты движок пытается рисовать через ускорение, не
# получает его и остаётся ни с чем: окно выходит чёрным. Так бывает в
# виртуальных машинах и на старом железе. Заранее переводим его на
# программную отрисовку — медленнее, зато видно.
if os.environ.get('GLOWER_SOFT') == '1' or not glob.glob('/dev/dri/renderD*'):
    for имя, значение in (('WEBKIT_DISABLE_COMPOSITING_MODE', '1'),
                          ('WEBKIT_DISABLE_DMABUF_RENDERER', '1'),
                          ('LIBGL_ALWAYS_SOFTWARE', '1'),
                          ('GALLIUM_DRIVER', 'llvmpipe')):
        os.environ.setdefault(имя, значение)
    print('GlowerOS: видеоускорения нет — рисую программно', file=sys.stderr, flush=True)

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('WebKit2', '4.1')
gi.require_version('GtkLayerShell', '0.1')
from gi.repository import Gtk, Gdk, Gio, WebKit2, GtkLayerShell, GLib   # noqa: E402

