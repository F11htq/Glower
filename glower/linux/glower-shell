# запрошенной: полоса под панель получалась на двенадцать точек шире, чем
# просили. Оболочке тени не нужны — убираем их разом для всех наших окон.
БЕЗ_ТЕНЕЙ = b"""
window, window.background, decoration, decoration:backdrop {
  box-shadow: none; margin: 0; border: 0; background-color: transparent;
}
"""

АДРЕС = os.environ.get('GLOWER_URL', 'http://localhost:8123/')
ПОЛОСА = int(os.environ.get('GLOWER_PANEL_H', '48'))
# Слой рабочего стола и его право на клавиатуру. Значения по умолчанию —
# рабочие; переменные оставлены, чтобы можно было проверить машину, где
# оконный сервер ведёт себя иначе.
# Чем показывать рабочий стол.
#
#   окно  — обычное окно оконного сервера, лежащее в самом низу стопки.
#           Единственный способ, при котором до рабочего стола доходит
#           клавиатура: поверхностям нижних слоёв оконный сервер её не
#           отдаёт, и в мастере первого запуска нельзя было напечатать
#           даже собственное имя.
#   слой  — поверхность слоя. Оставлено для проверок и для оконных
#           серверов, которые умеют отдавать таким поверхностям клавиатуру.
ВИД_СТОЛА = os.environ.get('GLOWER_SURFACE', 'окно')
СЛОЙ = os.environ.get('GLOWER_LAYER', 'bottom')
КЛАВИАТУРА = os.environ.get('GLOWER_KBD', 'on_demand')
ДОВОД = '&'.join(x for x in os.environ.get('GLOWER_QUERY', '').split('&') if x)


def адрес(поверхность):
    хвост = 'surface=' + поверхность + ('&' + ДОВОД if ДОВОД else '')
    return АДРЕС + ('&' if '?' in АДРЕС else '?') + хвост


def вид(поверхность):
    """Веб-вид с настройками, которые нужны оболочке, и без лишнего."""
    v = WebKit2.WebView()
    н = v.get_settings()
    н.set_property('enable-developer-extras', True)
    н.set_property('enable-write-console-messages-to-stdout', True)
    н.set_property('media-playback-requires-user-gesture', False)
    н.set_property('enable-back-forward-navigation-gestures', False)
    v.set_background_color(Gdk.RGBA(0, 0, 0, 0))
    v.load_uri(адрес(поверхность))

    def упало(вид_, событие, _данные=None):
        # Оболочка не должна пропадать молча: перезагружаем и пишем в журнал.
        print('GlowerOS: веб-вид упал (%s), перезагружаю' % поверхность, file=sys.stderr)
        GLib.timeout_add(1500, lambda: (вид_.load_uri(адрес(поверхность)), False)[1])
        return True
    v.connect('web-process-terminated', упало)
    return v


def распорка(высота):
    """Прозрачная полоса внизу экрана: держит место для панели задач.

    Ничего не рисует и щелчков не ловит — пустая область ввода означает, что
    любое нажатие проходит сквозь неё на рабочий стол, где панель и живёт."""
    окно = Gtk.Window()
    # Без этого GTK пририсовывает окну свою тень, поверхность выходит выше
    # запрошенного, и полоса под панель получается шире, чем нужно.
    окно.set_decorated(False)
    окно.set_app_paintable(True)
    экран = окно.get_screen()
    if экран is not None and экран.get_rgba_visual() is not None:
        окно.set_visual(экран.get_rgba_visual())
    окно.add(Gtk.DrawingArea())

    GtkLayerShell.init_for_window(окно)
    GtkLayerShell.set_layer(окно, GtkLayerShell.Layer.TOP)
    GtkLayerShell.set_namespace(окно, 'glower-полоса')
    for край in (К.BOTTOM, К.LEFT, К.RIGHT):
        GtkLayerShell.set_anchor(окно, край, True)
    окно.set_size_request(-1, высота)
    GtkLayerShell.set_exclusive_zone(окно, высота)
    GtkLayerShell.set_keyboard_mode(окно, GtkLayerShell.KeyboardMode.NONE)
    окно.show_all()

    окно_gdk = окно.get_window()
    if окно_gdk is not None:
        окно_gdk.input_shape_combine_region(cairo.Region(), 0, 0)

    if os.environ.get('GLOWER_DEBUG'):
        def покажи():
            а = окно.get_allocation()
            print('полоса: просили %d, поверхность %dx%d' % (высота, а.width, а.height),
                  file=sys.stderr, flush=True)
            return False
        GLib.timeout_add(1500, покажи)
    return окно


def распорка_x(высота):
    """То же самое под X-сервером: полоса внизу, которую уважают чужие окна.

    В X нет протокола слоёв, зато есть договорённость ровесница самого X:
    окно может объявить себя доком и попросить себе полосу экрана свойством
    _NET_WM_STRUT_PARTIAL. Оконный менеджер вычитает её из рабочей области —
    развёрнутое окно до этой полосы уже не достаёт. Раньше здесь не было
    ничего, и на старой машине чужая программа во весь экран просто
    закрывала панель задач собой."""
    окно = Gtk.Window()
    окно.set_decorated(False)
    окно.set_app_paintable(True)
    окно.set_type_hint(Gdk.WindowTypeHint.DOCK)
    окно.set_keep_above(True)
    окно.set_skip_taskbar_hint(True)
    окно.set_skip_pager_hint(True)
    окно.set_accept_focus(False)
    окно.set_focus_on_map(False)

    экран = окно.get_screen()
    if экран is not None and экран.get_rgba_visual() is not None:
        окно.set_visual(экран.get_rgba_visual())
    ширина = экран.get_width() if экран is not None else 1024
    высота_экрана = экран.get_height() if экран is not None else 768

    окно.add(Gtk.DrawingArea())
    окно.set_default_size(ширина, высота)
    окно.move(0, высота_экрана - высота)
    окно.show_all()
    окно.resize(ширина, высота)
    окно.move(0, высота_экрана - высота)

    окно_gdk = окно.get_window()
    if окно_gdk is not None:
        # Полоса ничего не рисует и щелчков не ловит: нажатие проходит сквозь
        # неё на рабочий стол, где панель и живёт.
        окно_gdk.input_shape_combine_region(cairo.Region(), 0, 0)
        попроси_полосу(окно_gdk, ширина, высота_экрана, высота)
    return окно


def попроси_полосу(окно_gdk, ширина, высота_экрана, высота):
    """Сказать оконному менеджеру, сколько экрана снизу занято.

    Свойство ставим сами, через ту же библиотеку X, которой пользуются все
    остальные. Соблазн позвать стороннюю программу xprop был велик, но её
    в системе может не оказаться — а тогда полоса молча не появится, и
    беда вернётся ровно туда, откуда её убирали.

    Тонкость, ради которой всё и написано руками: X ждёт здесь чисел
    размером в машинное слово, а не в объявленные тридцать два бита. Это
    его давняя странность, и промах в ней означает не ошибку, а мусор в
    свойстве и полосу неизвестной ширины."""
    try:
        xid = окно_gdk.get_xid()
    except Exception:
        return
    полоса = [0, 0, 0, высота,          # слева, справа, сверху, снизу
              0, 0, 0, 0, 0, 0,         # начала и концы первых трёх
              0, max(0, ширина - 1)]    # и наша — по всей ширине
    try:
        x11 = ctypes.CDLL('libX11.so.6')
        x11.XOpenDisplay.restype = ctypes.c_void_p
        x11.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
        x11.XInternAtom.restype = ctypes.c_ulong
        x11.XChangeProperty.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong,
                                        ctypes.c_ulong, ctypes.c_int, ctypes.c_int,
                                        ctypes.c_void_p, ctypes.c_int]
        x11.XFlush.argtypes = [ctypes.c_void_p]
        экран_x = x11.XOpenDisplay(None)
        if not экран_x:
            return
        try:
            КАРДИНАЛ = 6            # XA_CARDINAL
            ЗАМЕНИТЬ = 0            # PropModeReplace
            for имя, значения in (('_NET_WM_STRUT_PARTIAL', полоса),
                                  ('_NET_WM_STRUT', полоса[:4])):
                свойство = x11.XInternAtom(экран_x, имя.encode(), False)
                данные = (ctypes.c_long * len(значения))(*значения)
                x11.XChangeProperty(экран_x, ctypes.c_ulong(xid), свойство,
                                    ctypes.c_ulong(КАРДИНАЛ), 32, ЗАМЕНИТЬ,
                                    ctypes.byref(данные), len(значения))
            x11.XFlush(экран_x)
        finally:
            x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
            x11.XCloseDisplay(экран_x)
    except Exception as e:
        print('GlowerOS: не вышло попросить полосу под панель: %s' % e,
              file=sys.stderr, flush=True)


СЛОИ = {}
РЕЖИМЫ = {}


def стол_окном(имя):
    """Рабочий стол как обычное окно: во весь экран, без рамки, внизу стопки.

    Имя окна (glowershell) знает оконный сервер: по нему он держит стол под
    всеми окнами и не рисует ему рамку. Оболочка это же имя убирает из своей
    панели задач — рабочий стол не окно для человека, даже если он окно для
    оконного сервера."""
    окно = Gtk.Window()
    окно.set_decorated(False)
    окно.set_title('GlowerOS')
    в = вид(имя)
    окно.add(в)
    окно.connect('destroy', Gtk.main_quit)

    # Под X-сервером «на весь экран» — это просьба к оконному менеджеру, а на
    # старой машине его может не быть вовсе: окно тогда остаётся размером с
    # почтовую марку. Поэтому размер экрана берём сами и просим ровно его.
    экран = Gdk.Screen.get_default()
    if экран is not None:
        окно.set_default_size(экран.get_width(), экран.get_height())
        окно.move(0, 0)
    окно.show_all()
    окно.fullscreen()
    if экран is not None and not ПОД_WAYLAND:
        окно.resize(экран.get_width(), экран.get_height())
    # Ввод достаётся тому, кто его взял. Без этого окно есть, страница живёт,
    # а напечатать в ней нельзя ни буквы — именно так и было.
    в.set_can_focus(True)
    в.grab_focus()
    окно.set_focus(в)
    окно.present()
    return окно


def поверхность(имя, слой, края, высота=None, полоса=None):
    окно = Gtk.Window()
    окно.set_decorated(False)
    GtkLayerShell.init_for_window(окно)
    GtkLayerShell.set_layer(окно, слой)
    GtkLayerShell.set_namespace(окно, 'glower-' + имя)
    for край in края:
        GtkLayerShell.set_anchor(окно, край, True)
    if высота:
        окно.set_size_request(-1, высота)
    # Полоса экрана, которую оконный сервер вычтет из рабочей области: ни одно
    # окно, даже развёрнутое во весь экран, не сможет её закрыть.
    GtkLayerShell.set_exclusive_zone(окно, полоса if полоса is not None else -1)
    GtkLayerShell.set_keyboard_mode(окно, РЕЖИМЫ.get(КЛАВИАТУРА, GtkLayerShell.KeyboardMode.ON_DEMAND))
    в = вид(имя)
    окно.add(в)
    окно.connect('destroy', Gtk.main_quit)
    окно.show_all()
    в.set_can_focus(True)
    в.grab_focus()
    окно.set_focus(в)
    return окно


# ==========================================================================
#  Уведомления настоящих программ
#
#  Программы Linux сообщают о событиях через общую шину сеанса: письмо
#  пришло, файл скачался, музыка сменилась. Без приёмника эти сообщения
#  просто пропадают, и человек не понимает, почему система молчит.
#
#  Здесь оболочка сама становится приёмником: занимает известное имя на
#  шине и пересылает всё пришедшее рабочему столу — тот показывает это
#  своими средствами, как собственные уведомления.
# ==========================================================================
ОПИСАНИЕ = """
<node>
  <interface name='org.freedesktop.Notifications'>
    <method name='Notify'>
      <arg type='s' name='app_name' direction='in'/>
      <arg type='u' name='replaces_id' direction='in'/>
      <arg type='s' name='app_icon' direction='in'/>
      <arg type='s' name='summary' direction='in'/>
      <arg type='s' name='body' direction='in'/>
      <arg type='as' name='actions' direction='in'/>
      <arg type='a{sv}' name='hints' direction='in'/>
      <arg type='i' name='expire_timeout' direction='in'/>
      <arg type='u' name='id' direction='out'/>
    </method>
    <method name='CloseNotification'>
      <arg type='u' name='id' direction='in'/>
    </method>
    <method name='GetCapabilities'>
      <arg type='as' name='caps' direction='out'/>
    </method>
    <method name='GetServerInformation'>
      <arg type='s' name='name' direction='out'/>
      <arg type='s' name='vendor' direction='out'/>
      <arg type='s' name='version' direction='out'/>
      <arg type='s' name='spec_version' direction='out'/>
    </method>
  </interface>
</node>
"""


def скажи_столу(тема, что):
    """Передаём рабочему столу через агента: он и покажет."""
    try:
        запрос = urllib.request.Request(
            АДРЕС.split('?')[0].rstrip('/') + '/rpc',
            data=json.dumps({'method': 'ui.say', 'params': {'тема': тема, 'что': что}}).encode(),
            headers={'Content-Type': 'application/json'})
        urllib.request.urlopen(запрос, timeout=2).read()
    except Exception:
        pass


def приём_уведомлений():
    счёт = {'n': 0}

    def вызов(_соединение, _кто, _путь, _интерфейс, метод, доводы, ответ):
        if метод == 'Notify':
            имя, замена, значок, заголовок, текст = доводы[0], доводы[1], доводы[2], доводы[3], доводы[4]
            счёт['n'] += 1
            номер = замена or счёт['n']
            скажи_столу('уведомление', {'откуда': имя, 'значок': значок,
                                        'заголовок': заголовок, 'текст': текст, 'номер': номер})
            ответ.return_value(GLib.Variant('(u)', (номер,)))
        elif метод == 'CloseNotification':
            скажи_столу('уведомление-закрыть', {'номер': доводы[0]})
            ответ.return_value(None)
        elif метод == 'GetCapabilities':
            ответ.return_value(GLib.Variant('(as)', (['body', 'persistence'],)))
        elif метод == 'GetServerInformation':
            ответ.return_value(GLib.Variant('(ssss)', ('GlowerOS', 'GlowerOS', '1.0', '1.2')))
        else:
            ответ.return_value(None)

    def занято(соединение, имя, _данные=None):
        узел = Gio.DBusNodeInfo.new_for_xml(ОПИСАНИЕ)
        соединение.register_object('/org/freedesktop/Notifications', узел.interfaces[0], вызов, None, None)
        print('GlowerOS: принимаю уведомления программ', file=sys.stderr, flush=True)

    try:
        Gio.bus_own_name(Gio.BusType.SESSION, 'org.freedesktop.Notifications',
                         Gio.BusNameOwnerFlags.NONE, занято, None, None)
    except Exception as e:
        print('GlowerOS: уведомления принять не вышло: %s' % e, file=sys.stderr, flush=True)


def следи_за_полосой(окно):
    """Панель задач меняет высоту — вместе с ней меняется и занятая полоса.

    Оболочка сама сообщает свою высоту агенту, а мы её спрашиваем: так полоса
    всегда ровно под панелью, и ни щели, ни лишнего края не остаётся."""
    состояние = {'высота': ПОЛОСА}

    def спроси():
        try:
            запрос = urllib.request.Request(
                АДРЕС.split('?')[0].rstrip('/') + '/rpc',
                data=json.dumps({'method': 'ui.last', 'params': {'тема': 'полоса'}}).encode(),
                headers={'Content-Type': 'application/json'})
            ответ = json.loads(urllib.request.urlopen(запрос, timeout=2).read().decode())
            что = (ответ.get('result') or {}).get('что')
            высота = int(что) if что else None
        except Exception:
            высота = None
        if os.environ.get('GLOWER_DEBUG'):
            print('агент сказал про полосу: %r' % (высота,), file=sys.stderr, flush=True)
        if высота and 20 <= высота <= 200 and высота != состояние['высота']:
            состояние['высота'] = высота
            окно.set_size_request(-1, высота)
            if ПОД_WAYLAND:
                GtkLayerShell.set_exclusive_zone(окно, высота)
            else:
                экран = окно.get_screen()
                ш = экран.get_width() if экран is not None else 1024
                в = экран.get_height() if экран is not None else 768
                окно.resize(ш, высота)
                окно.move(0, в - высота)
                окно_gdk = окно.get_window()
                if окно_gdk is not None:
                    попроси_полосу(окно_gdk, ш, в, высота)
        return True

    GLib.timeout_add_seconds(2, спроси)


# Имя, под которым оконный сервер знает наш рабочий стол
GLib.set_prgname('glowershell')

стиль = Gtk.CssProvider()
стиль.load_from_data(БЕЗ_ТЕНЕЙ)
Gtk.StyleContext.add_provider_for_screen(
    Gdk.Screen.get_default(), стиль, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

# Под каким оконным сервером мы работаем. Слои (полоса под панель и
# поверхности рабочего стола) — умение Wayland; под X-сервером их нет, и
# просить их нельзя: программа просто упадёт. На такой машине рабочий стол
# показывается обычным окном во весь экран, а панель рисуется поверх него.
ПОД_WAYLAND = 'wayland' in type(Gdk.Display.get_default()).__name__.lower()
if not ПОД_WAYLAND:
    print('GlowerOS: оконный сервер без слоёв — рабочий стол будет обычным окном',
          file=sys.stderr, flush=True)

К = GtkLayerShell.Edge
СЛОИ.update(background=GtkLayerShell.Layer.BACKGROUND, bottom=GtkLayerShell.Layer.BOTTOM,
            top=GtkLayerShell.Layer.TOP, overlay=GtkLayerShell.Layer.OVERLAY)
РЕЖИМЫ.update(none=GtkLayerShell.KeyboardMode.NONE,
              on_demand=GtkLayerShell.KeyboardMode.ON_DEMAND,
              exclusive=GtkLayerShell.KeyboardMode.EXCLUSIVE)
if ВИД_СТОЛА == 'окно' or not ПОД_WAYLAND:
    стол_окном('desktop')
else:
    поверхность('desktop', СЛОИ.get(СЛОЙ, GtkLayerShell.Layer.BOTTOM),
                [К.TOP, К.BOTTOM, К.LEFT, К.RIGHT], полоса=-1)
# Полосу под панель задач отводит оконный сервер — каждый своим способом.
if ПОЛОСА > 0:
    следи_за_полосой(распорка(ПОЛОСА) if ПОД_WAYLAND else распорка_x(ПОЛОСА))
приём_уведомлений()

Gtk.main()
