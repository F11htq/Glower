<?xml version="1.0"?>
<!--
  Настройки оконного сервера для экрана входа.

  Отдельные от рабочего стола, и вот почему. На рабочем столе оболочка —
  это фон: правило держит её в самом низу стопки, чтобы чужие окна вставали
  поверх. Но окно, отправленное вниз, не получает и клавиатуру — на экране
  входа это значило, что в поле пароля нельзя напечатать ни буквы: курсор
  ходил, часы шли, а клавиши уходили в пустоту.

  Здесь окно всего одно и никакого «низа» ему не нужно. Никаких правил —
  оболочка получает фокус, как обычное окно, и слышит клавиатуру.
-->
<labwc_config>

  <core>
    <gap>0</gap>
  </core>

  <theme>
    <cornerRadius>0</cornerRadius>
    <font name="sans" size="10" />
  </theme>

  <keyboard>
    <default />
  </keyboard>

  <mouse>
    <default />
  </mouse>

</labwc_config>
