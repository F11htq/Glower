# Заставка загрузки GlowerOS — неподвижная.
#
# Прежде здесь крутился вихрь, вокруг ходил рой частиц, дышало свечение и
# бежал блик по полосе хода. Человек попросил убрать анимации при включении
# и выключении: осталось одно приветствие после первой настройки. Теперь
# здесь логотип на тёмном фоне, а при выключении и перезагрузке — ещё и
# слово о том, что происходит. Ничего не движется, и каждый кадр ничего не
# пересчитывает — машине в эту секунду и без нас есть чем заняться.
#
# Язык заставки понимает только латинские имена — поясняем по-русски.

Window.SetBackgroundTopColor(0.035, 0.04, 0.085);
Window.SetBackgroundBottomColor(0.01, 0.01, 0.03);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
cx = screen_w / 2;
cy = screen_h / 2 - screen_h / 22;

size = Math.Int(screen_h / 5.2);
logo_img = Image("logo.png").Scale(size, size);
logo = Sprite(logo_img);
logo.SetX(cx - size / 2);
logo.SetY(cy - size / 2);
logo.SetZ(20);

# Надпись — та же, что в логотипе (word.png); нет файла — словами
word_src = Image("word.png");
if (word_src){
  word_w = Math.Int(size * 1.35);
  word_img = word_src.Scale(word_w, Math.Int(word_w * word_src.GetHeight() / word_src.GetWidth()));
} else {
  word_img = Image.Text("GlowerOS", 1, 1, 1, 1, "Sans Bold " + Math.Int(size / 6.5));
}
word = Sprite(word_img);
word.SetX(cx - word_img.GetWidth() / 2);
word_y = cy + size / 2 + size * 0.22;
word.SetY(word_y);
word.SetZ(20);
# Пять точек по кругу, как в Windows. Та же разметка и та же формула, что
# у заставки после входа (panel/src/splash.rs): от включения до стола экран
# не меняется, только бегут точки
ring_r = Math.Int(size * 0.15);
if (ring_r < 14) ring_r = 14;
ring_y = word_y + word_img.GetHeight() + size * 0.42 + ring_r;
dot_r = ring_r * 0.12;
if (dot_r < 2.5) dot_r = 2.5;
dot_d = Math.Int(dot_r * 2 + 0.5);
dot_src = Image("dot.png");
i = 0;
while (i < 5){
  dots[i] = Sprite();
  if (dot_src) dots[i].SetImage(dot_src.Scale(dot_d, dot_d));
  dots[i].SetOpacity(0);
  dots[i].SetZ(30);
  i = i + 1;
}
spin_t = 0;
spin_on = 1;

fun dot_angle(t, i){
  p = (t - i * 0.11) / 2.4;
  p = p - Math.Int(p);
  if (p < 0) p = p + 1;
  if (p > 0.88) return -1000;
  q = p / 0.88;
  path = q - Math.Sin(2 * Math.Pi * q) / (2 * Math.Pi) * 0.75;
  return Math.Pi / 2 + path * 2 * Math.Pi * 1.25;
}

# Plymouth зовёт это 50 раз в секунду
fun refresh_callback(){
  global.spin_t = global.spin_t + 1 / 50;
  # Первые полсекунды точки проявляются
  fade = global.spin_t / 0.5;
  if (fade > 1) fade = 1;
  local.i = 0;
  while (local.i < 5){
    a = dot_angle(global.spin_t, local.i);
    if (a < -100 || global.spin_on == 0){
      global.dots[local.i].SetOpacity(0);
    } else {
      global.dots[local.i].SetX(cx + ring_r * Math.Cos(a) - dot_d / 2);
      global.dots[local.i].SetY(ring_y + ring_r * Math.Sin(a) - dot_d / 2);
      global.dots[local.i].SetOpacity(0.95 * fade);
    }
    local.i = local.i + 1;
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# Надписи («Выключение…», пароль диска) — под точками
text_y = ring_y + ring_r + size * 0.2;

# Что сейчас: загрузка, выключение или перезагрузка
mode = Plymouth.GetMode();
if (mode == "shutdown" || mode == "reboot"){
  if (mode == "reboot") st = "Перезагрузка…";
  else st = "Выключение…";
  st_img = Image.Text(st, 1, 1, 1, 0.7, "Sans " + Math.Int(size / 10));
  status = Sprite(st_img);
  status.SetX(cx - st_img.GetWidth() / 2);
  status.SetY(text_y);
  status.SetZ(20);
}

# ---------- пароль зашифрованного диска ----------
#
# Спрайты заводим заранее и один раз. Каждое нажатие клавиши — это новый
# вызов сюда, и если создавать спрайт на каждый вызов, старые остаются
# лежать на экране: подсказка расплывается в кашу, а точки множатся.
prompt_sprite = Sprite();
prompt_sprite.SetOpacity(0);
prompt_sprite.SetZ(40);
bullet_sprite = Sprite();
bullet_sprite.SetOpacity(0);
bullet_sprite.SetZ(40);

fun display_password_callback(prompt, bullets){
  global.spin_on = 0;
  # Вопрос приходит из недр начальной загрузки и всегда по-английски:
  # «Please unlock disk glower». Человеку, который включил свою машину,
  # незачем читать служебную латынь — подменяем на понятное.
  if (prompt.SubString(0, 6) == "Please"){
    prompt = "Введите пароль диска";
  }
  text = Image.Text(prompt, 1, 1, 1);
  prompt_sprite.SetImage(text);
  prompt_sprite.SetX(cx - text.GetWidth() / 2);
  prompt_sprite.SetY(text_y);
  prompt_sprite.SetOpacity(1);

  # Сколько букв набрано, столько и точек: человек должен видеть, что
  # машина его слышит. Пустую строку рисовать нельзя — вместо этого прячем.
  if (bullets > 0){
    str = "";
    i = 0;
    while (i < bullets){
      str += "•";
      i++;
    }
    marks = Image.Text(str, 1, 1, 1);
    bullet_sprite.SetImage(marks);
    bullet_sprite.SetX(cx - marks.GetWidth() / 2);
    bullet_sprite.SetY(text_y + text.GetHeight() + 10);
    bullet_sprite.SetOpacity(1);
  } else {
    bullet_sprite.SetOpacity(0);
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# Пароль принят или спрашивать больше нечего — убираем вопрос с экрана
fun display_normal_callback(){
  global.spin_on = 1;
  prompt_sprite.SetOpacity(0);
  bullet_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
