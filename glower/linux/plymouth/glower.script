# Заставка загрузки GlowerOS: логотип и комета на орбите.
#
# Комета — та же, что в знаке системы: светлая голова с тёплым ореолом
# бежит по едва видному кольцу, хвост тает из тёплого белого в голубой.
# Сверху она разгоняется, снизу притормаживает, и хвост то вытягивается,
# то подбирается.
#
# Каждый кадр нарисован заранее (spin-0.png … spin-99.png, их рисует
# glower-splash --кадры той же функцией, что и заставку после входа):
# Plymouth перерисовывает экран 50 раз в секунду, и на каждый его кадр —
# свой рисунок. Раньше точки двигались по экрану сами и вставали только на
# целые пиксели — отсюда и подёргивание. Теперь картинка стоит на месте, а
# меняется только её содержимое, сглаженное при рисовании.
#
# Язык заставки понимает только латинские имена — поясняем по-русски.

Window.SetBackgroundTopColor(0.035, 0.04, 0.085);
Window.SetBackgroundBottomColor(0.01, 0.01, 0.03);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
cx = screen_w / 2;
cy = screen_h / 2 - screen_h / 22;

size = Math.Int(screen_h / 5.2);
logo_img = Image("logo.png").Scale(size, size);
logo = Sprite(logo_img);
logo.SetX(cx - size / 2);
logo.SetY(cy - size / 2);
logo.SetZ(20);

# Надпись — та же, что в логотипе (word.png); нет файла — словами
word_src = Image("word.png");
if (word_src){
  word_w = Math.Int(size * 1.35);
  word_img = word_src.Scale(word_w, Math.Int(word_w * word_src.GetHeight() / word_src.GetWidth()));
} else {
  word_img = Image.Text("GlowerOS", 1, 1, 1, 1, "Sans Bold " + Math.Int(size / 6.5));
}
word = Sprite(word_img);
word.SetX(cx - word_img.GetWidth() / 2);
word_y = cy + size / 2 + size * 0.22;
word.SetY(word_y);
word.SetZ(20);
# Комета: та же разметка, что у заставки после входа (panel/src/splash.rs)
spin_r = Math.Int(size * 0.17);
if (spin_r < 16) spin_r = 16;
ring_y = word_y + word_img.GetHeight() + size * 0.42 + spin_r;
# Кадры нарисованы на холсте 208 точек с орбитой радиуса 72
spin_d = Math.Int(208 * spin_r / 72 + 0.5);
# Кадров нет (тему собрали без них) — комету не показываем
spin_n = 0;
spin_more = 1;
while (spin_more && spin_n < 100){
  src = Image("spin-" + spin_n + ".png");
  if (src){
    frames[spin_n] = src.Scale(spin_d, spin_d);
    spin_n = spin_n + 1;
  } else {
    spin_more = 0;
  }
}
spin = Sprite();
spin.SetX(Math.Int(cx - spin_d / 2));
spin.SetY(Math.Int(ring_y - spin_d / 2));
spin.SetZ(30);
spin.SetOpacity(0);
spin_k = 0;
spin_on = 1;

# Plymouth зовёт это 50 раз в секунду: один вызов — один кадр
fun refresh_callback(){
  if (global.spin_n == 0) return;
  global.spin_k = global.spin_k + 1;
  f = global.spin_k - Math.Int(global.spin_k / global.spin_n) * global.spin_n;
  global.spin.SetImage(global.frames[f]);
  # Первые полсекунды комета проявляется
  fade = global.spin_k / 25;
  if (fade > 1) fade = 1;
  if (global.spin_on == 0) fade = 0;
  global.spin.SetOpacity(fade);
}
Plymouth.SetRefreshFunction(refresh_callback);

# Надписи («Выключение…», пароль диска) — под кометой
text_y = ring_y + spin_r + size * 0.2;

# Что сейчас: загрузка, выключение или перезагрузка
mode = Plymouth.GetMode();
if (mode == "shutdown" || mode == "reboot"){
  if (mode == "reboot") st = "Перезагрузка…";
  else st = "Выключение…";
  st_img = Image.Text(st, 1, 1, 1, 0.7, "Sans " + Math.Int(size / 10));
  status = Sprite(st_img);
  status.SetX(cx - st_img.GetWidth() / 2);
  status.SetY(text_y);
  status.SetZ(20);
}

# ---------- пароль зашифрованного диска ----------
#
# Спрайты заводим заранее и один раз. Каждое нажатие клавиши — это новый
# вызов сюда, и если создавать спрайт на каждый вызов, старые остаются
# лежать на экране: подсказка расплывается в кашу, а точки пароля множатся.
prompt_sprite = Sprite();
prompt_sprite.SetOpacity(0);
prompt_sprite.SetZ(40);
bullet_sprite = Sprite();
bullet_sprite.SetOpacity(0);
bullet_sprite.SetZ(40);

fun display_password_callback(prompt, bullets){
  global.spin_on = 0;
  # Вопрос приходит из недр начальной загрузки и всегда по-английски:
  # «Please unlock disk glower». Человеку, который включил свою машину,
  # незачем читать служебную латынь — подменяем на понятное.
  if (prompt.SubString(0, 6) == "Please"){
    prompt = "Введите пароль диска";
  }
  text = Image.Text(prompt, 1, 1, 1);
  prompt_sprite.SetImage(text);
  prompt_sprite.SetX(cx - text.GetWidth() / 2);
  prompt_sprite.SetY(text_y);
  prompt_sprite.SetOpacity(1);

  # Сколько букв набрано, столько и точек: человек должен видеть, что
  # машина его слышит. Пустую строку рисовать нельзя — вместо этого прячем.
  if (bullets > 0){
    str = "";
    i = 0;
    while (i < bullets){
      str += "•";
      i++;
    }
    marks = Image.Text(str, 1, 1, 1);
    bullet_sprite.SetImage(marks);
    bullet_sprite.SetX(cx - marks.GetWidth() / 2);
    bullet_sprite.SetY(text_y + text.GetHeight() + 10);
    bullet_sprite.SetOpacity(1);
  } else {
    bullet_sprite.SetOpacity(0);
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# Пароль принят или спрашивать больше нечего — убираем вопрос с экрана
fun display_normal_callback(){
  global.spin_on = 1;
  prompt_sprite.SetOpacity(0);
  bullet_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
