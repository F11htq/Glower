# Заставка загрузки GlowerOS: чёрный экран и мигающий курсор терминала.
#
# Сама анимация — знак из строк кода — идёт дальше, под экраном входа
# (glower-splash --вход): курсор вытягивается в линию, строки кода
# собираются в логотип. Здесь только курсор, на том же месте и того же
# размера: на многих машинах Plymouth видно секунду-две, и анимация здесь
# просто не успевала показаться — человек видел чёрный экран.
#
# Язык заставки понимает только латинские имена — поясняем по-русски.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
cx = screen_w / 2;
cy = screen_h / 2 - screen_h / 22;

# Разметка — та же, что в panel/src/splash.rs (модуль «код»): знак из кода
# в полтора раза крупнее обычного, сорок рядов на его высоту; знакоместо
# моноширинного шрифта — шесть десятых высоты ряда
size = Math.Int(screen_h / 5.2 * 1.5);
row_h = size / 40;
cell = Math.Int(row_h * 0.59 + 0.5);
if (cell < 1) cell = 1;

cursor = Sprite(Image("dot.png").Scale(cell, Math.Int(row_h * 2 + 0.5)));
cursor.SetX(Math.Int(cx - cell / 2 + 0.5));
cursor.SetY(Math.Int(cy - row_h + 0.5));
cursor.SetZ(30);

frame = 0;
spin_on = 1;

# Plymouth зовёт это 50 раз в секунду. Курсор мигает, как в терминале:
# полсекунды горит, полсекунды нет; на время вопроса о пароле прячется
fun refresh_callback(){
  global.frame = global.frame + 1;
  b = Math.Int(global.frame / 25);
  if (global.spin_on && b - Math.Int(b / 2) * 2 == 0) global.cursor.SetOpacity(1);
  else global.cursor.SetOpacity(0);
}
Plymouth.SetRefreshFunction(refresh_callback);

# Надписи («Выключение…», пароль диска) — под курсором
text_y = cy + size * 0.3;

# Что сейчас: загрузка, выключение или перезагрузка
mode = Plymouth.GetMode();
if (mode == "shutdown" || mode == "reboot"){
  if (mode == "reboot") st = "Перезагрузка…";
  else st = "Выключение…";
  st_img = Image.Text(st, 1, 1, 1, 0.7, "Sans " + Math.Int(size / 15));
  status = Sprite(st_img);
  status.SetX(cx - st_img.GetWidth() / 2);
  status.SetY(text_y);
  status.SetZ(20);
}

# ---------- пароль зашифрованного диска ----------
#
# Спрайты заводим заранее и один раз. Каждое нажатие клавиши — это новый
# вызов сюда, и если создавать спрайт на каждый вызов, старые остаются
# лежать на экране: подсказка расплывается в кашу, а точки пароля множатся.
prompt_sprite = Sprite();
prompt_sprite.SetOpacity(0);
prompt_sprite.SetZ(40);
bullet_sprite = Sprite();
bullet_sprite.SetOpacity(0);
bullet_sprite.SetZ(40);

fun display_password_callback(prompt, bullets){
  global.spin_on = 0;
  # Вопрос приходит из недр начальной загрузки и всегда по-английски:
  # «Please unlock disk glower». Человеку, который включил свою машину,
  # незачем читать служебную латынь — подменяем на понятное.
  if (prompt.SubString(0, 6) == "Please"){
    prompt = "Введите пароль диска";
  }
  text = Image.Text(prompt, 1, 1, 1);
  prompt_sprite.SetImage(text);
  prompt_sprite.SetX(cx - text.GetWidth() / 2);
  prompt_sprite.SetY(text_y);
  prompt_sprite.SetOpacity(1);

  # Сколько букв набрано, столько и точек: человек должен видеть, что
  # машина его слышит. Пустую строку рисовать нельзя — вместо этого прячем.
  if (bullets > 0){
    str = "";
    i = 0;
    while (i < bullets){
      str += "•";
      i++;
    }
    marks = Image.Text(str, 1, 1, 1);
    bullet_sprite.SetImage(marks);
    bullet_sprite.SetX(cx - marks.GetWidth() / 2);
    bullet_sprite.SetY(text_y + text.GetHeight() + 10);
    bullet_sprite.SetOpacity(1);
  } else {
    bullet_sprite.SetOpacity(0);
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# Пароль принят или спрашивать больше нечего — убираем вопрос с экрана
fun display_normal_callback(){
  global.spin_on = 1;
  prompt_sprite.SetOpacity(0);
  bullet_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
