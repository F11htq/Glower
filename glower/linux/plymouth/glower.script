# Заставка загрузки GlowerOS.
#
# Показывает то, что человеку важно: систему, которая загружается, и что она
# жива. Бегущим сообщениям место в пункте меню «с сообщениями системы» — для
# разбора поломок, а не для каждого включения.
#
# Язык заставки простой и понимает только латинские имена, поэтому имена
# здесь английские, а поясняем по-русски.

Window.SetBackgroundTopColor(0.05, 0.05, 0.08);
Window.SetBackgroundBottomColor(0.02, 0.02, 0.04);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# Логотип по центру, ростом в шестую часть экрана
logo_img = Image("logo.png");
size = screen_h / 6;
k = size / logo_img.GetHeight();
logo = logo_img.Scale(logo_img.GetWidth() * k, size);
logo_sprite = Sprite(logo);
logo_sprite.SetX(screen_w / 2 - logo.GetWidth() / 2);
logo_sprite.SetY(screen_h / 2 - logo.GetHeight() / 2 - screen_h / 20);

# Точки под логотипом: по ним видно, что система жива, а не встала
dots = 5;
tick = 0;
dot_sprites = [];
i = 0;
while (i < dots){
  d = Image("dot.png");
  s = Sprite(d);
  s.SetX(screen_w / 2 - (dots * 26) / 2 + i * 26);
  s.SetY(screen_h / 2 + size / 2 + screen_h / 22);
  s.SetOpacity(0.25);
  dot_sprites[i] = s;
  i++;
}

fun refresh_callback(){
  tick++;
  n = Math.Int(tick / 6) % dots;
  j = 0;
  while (j < dots){
    if (j == n){
      dot_sprites[j].SetOpacity(1);
    } else {
      dot_sprites[j].SetOpacity(0.25);
    }
    j++;
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# Если система спросит пароль (зашифрованный диск) — покажем подсказку.
#
# Спрайты заводим заранее и один раз. Каждое нажатие клавиши — это новый
# вызов сюда, и если создавать спрайт на каждый вызов, старые остаются
# лежать на экране: подсказка расплывается в кашу, а точки множатся.
prompt_sprite = Sprite();
prompt_sprite.SetOpacity(0);
bullet_sprite = Sprite();
bullet_sprite.SetOpacity(0);

fun display_password_callback(prompt, bullets){
  # Вопрос приходит из недр начальной загрузки и всегда по-английски:
  # «Please unlock disk glower». Человеку, который включил свою машину,
  # незачем читать служебную латынь — подменяем на понятное.
  if (prompt.SubString(0, 6) == "Please"){
    prompt = "Введите пароль диска";
  }
  text = Image.Text(prompt, 1, 1, 1);
  prompt_sprite.SetImage(text);
  prompt_sprite.SetX(screen_w / 2 - text.GetWidth() / 2);
  prompt_sprite.SetY(screen_h / 2 + size);
  prompt_sprite.SetOpacity(1);

  # Сколько букв набрано, столько и точек: человек должен видеть, что
  # машина его слышит. Пустую строку рисовать нельзя — вместо этого прячем.
  if (bullets > 0){
    str = "";
    i = 0;
    while (i < bullets){
      str += "*";
      i++;
    }
    marks = Image.Text(str, 1, 1, 1);
    bullet_sprite.SetImage(marks);
    bullet_sprite.SetX(screen_w / 2 - marks.GetWidth() / 2);
    bullet_sprite.SetY(screen_h / 2 + size + text.GetHeight() + 10);
    bullet_sprite.SetOpacity(1);
  } else {
    bullet_sprite.SetOpacity(0);
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# Пароль принят или спрашивать больше нечего — убираем вопрос с экрана
fun display_normal_callback(){
  prompt_sprite.SetOpacity(0);
  bullet_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
