#!/bin/sh
# ==========================================================================
#  Сеанс GlowerOS: агент + оболочка в режиме киоска.
#
#  Пробует по очереди, пока что-нибудь не заработает:
#    1) labwc — настоящий оконный сервер: чужие окна живут рядом с оболочкой;
#    2) cage, киоск на одно окно — если labwc на этой машине не пошёл;
#    3) X-сервер с ускорением;
#    4) X-сервер на программной отрисовке — виртуалки и старое железо.
#  Отказ одного способа не хоронит сеанс: он просто берётся за следующий.
#  Если не вышло ничего — на экране остаётся понятное объяснение,
#  а не мигающий курсор.
# ==========================================================================
set -e

# Особые права ядра сеансу не нужны, а песочнице flatpak они прямо мешают:
# она отказывается работать, если у позвавшего есть права, но он не setuid.
# Юнит их уже снимает; здесь — на случай запуска сеанса иным способом.
if [ -z "${GLOWER_NO_CAPS:-}" ] && command -v setpriv >/dev/null 2>&1; then
  GLOWER_NO_CAPS=1
  export GLOWER_NO_CAPS
  exec setpriv --ambient-caps=-all --inh-caps=-all "$0" "$@"
fi

# Настоящим программам Linux нужна общая шина сеанса: через неё работают
# уведомления, портал выбора файлов и песочница flatpak. Без неё программы
# запускаются, но ведут себя странно и молча. Поднимаем её на весь сеанс.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
  exec dbus-run-session -- "$0" "$@"
fi

ROOT="${GLOWER_ROOT:-$HOME/GlowerOS}"
PORT="${GLOWER_PORT:-8123}"
UI="${GLOWER_UI:-/usr/share/glower/ui}"
FLAGS="${GLOWER_FLAGS:---system --allow-open --allow-launch --allow-power --allow-install --allow-net --allow-packages}"
LOG="${GLOWER_LOG:-/var/log/glower-session.log}"

mkdir -p "$ROOT"
touch "$LOG" 2>/dev/null || LOG="$HOME/glower-session.log"

say(){ printf '%s\n' "$1"; printf '%s\n' "$1" >> "$LOG" 2>/dev/null || true; }

BROWSER="${GLOWER_BROWSER:-$(command -v chromium || command -v chromium-browser || command -v google-chrome || true)}"
[ -n "$BROWSER" ] || { say "GlowerOS: браузер не найден — оболочку нечем показать"; exit 1; }

# Браузер норовит показать поверх оболочки свои предложения — например,
# «перевести страницу». Ключа мало: часть таких подсказок читается из
# настроек профиля, поэтому заводим профиль сразу с выключенным переводом.
PROFILE="$HOME/.local/share/glower/browser"
if [ ! -f "$PROFILE/Default/Preferences" ]; then
  mkdir -p "$PROFILE/Default"
  cat > "$PROFILE/Default/Preferences" <<'PREFS'
{"translate":{"enabled":false},
 "translate_site_blacklist":[],
 "profile":{"default_content_setting_values":{"notifications":2}},
 "bookmark_bar":{"show_on_all_tabs":false},
 "credentials_enable_service":false,
 "credentials_enable_autosignin":false}
PREFS
fi

# --- агент: мост между оболочкой и машиной ---
# GLOWER_BROWSER передаём и агенту: тем же движком он рисует страницы
# во встроенном браузере системы.
GLOWER_BROWSER="$BROWSER" node "$UI/agent/server.mjs" --port "$PORT" --root "$ROOT" $FLAGS >>"$LOG" 2>&1 &
AGENT=$!
trap 'kill $AGENT 2>/dev/null' EXIT INT TERM

i=0
while [ $i -lt 50 ]; do
  curl -sf "http://localhost:$PORT/" >/dev/null 2>&1 && break
  i=$((i+1)); sleep 0.2
done

# Пункт меню «Установить GlowerOS» передаёт ядру glower.install=1 —
# оболочка по этому признаку открывает мастер установки сразу.
QUERY_EXTRA=""
grep -q 'glower.install=1' /proc/cmdline 2>/dev/null && QUERY_EXTRA="&install=1"
grep -q 'glower.repair=1' /proc/cmdline 2>/dev/null && QUERY_EXTRA="$QUERY_EXTRA&repair=1"

# --- на чём рисовать ---
# Набор ключей собираем на каждую попытку заново: если ускоренный запуск
# не удался, следующая попытка идёт уже начисто, на программной отрисовке.
cmdline(){   # $1 — режим: gpu | soft
  if [ "$1" = "soft" ]; then
    q="session=1&lite=1$QUERY_EXTRA"; g="--disable-gpu --disable-gpu-compositing --disable-features=VizDisplayCompositor"
  else
    q="session=1$QUERY_EXTRA"; g="--enable-features=VaapiVideoDecoder"
  fi
  printf '%s' "--kiosk http://localhost:$PORT/?$q
--no-first-run --no-default-browser-check --disable-search-engine-choice-screen
--disable-sync --password-store=basic --use-mock-keychain
--deny-permission-prompts --noerrdialogs --disable-infobars
--disable-session-crashed-bubble --disable-features=Translate,TranslateUI,MediaRouter
--disable-background-timer-throttling --disable-backgrounding-occluded-windows
--disable-renderer-backgrounding --autoplay-policy=no-user-gesture-required
--user-data-dir=$HOME/.local/share/glower/browser --class=glowershell $g"
}

HAVE_DRI=no
ls /dev/dri/card* >/dev/null 2>&1 && HAVE_DRI=yes
[ "$HAVE_DRI" = yes ] || say "GlowerOS: видеоускорения нет — облегчённый режим"

# Ни cage, ни X не запускаем через exec: если способ не заведётся именно на
# этой машине, сеанс должен пережить отказ и попробовать следующий, а не
# умереть вместе с ним. Раньше из-за этого приходилось вручную выбирать
# в меню загрузки «безопасную графику».
# labwc — оконный сервер. Оболочка запускается его же средствами и лежит в
# самом низу стопки: чужие окна встают поверх неё, как и положено окнам, но
# в отличие от киоска остаются переключаемыми — и клавишами, и панелью задач.
# Есть ли на машине всё для настоящего рабочего стола: движок WebKit и
# протокол слоёв. Если да, оболочку показывает своя программа, а не браузер.
have_webkit(){
  command -v glower-shell >/dev/null || return 1
  python3 - >/dev/null 2>&1 <<'PYCHECK'
import gi
gi.require_version('Gtk', '3.0')
gi.require_version('WebKit2', '4.1')
gi.require_version('GtkLayerShell', '0.1')
from gi.repository import Gtk, WebKit2, GtkLayerShell
PYCHECK
}

run_labwc(){
  command -v labwc >/dev/null || return 1
  [ "$HAVE_DRI" = yes ] || return 1
  say "GlowerOS: пробую labwc (Wayland)"
  mkdir -p "$HOME/.local/share/glower"
  START_SH="$HOME/.local/share/glower/shell.sh"

  if have_webkit; then
    # Рабочий стол — настоящая поверхность нижнего слоя, а под панель задач
    # отводится полоса экрана, которую оконный сервер вычитает из рабочей
    # области: развёрнутое окно её не закроет.
    say "GlowerOS: оболочку показывает своя программа на WebKit"
    cat > "$START_SH" <<STARTUP
#!/bin/sh
GLOWER_URL="http://localhost:$PORT/" \
GLOWER_QUERY="session=1$QUERY_EXTRA" \
GLOWER_PANEL_H="${GLOWER_PANEL_H:-48}" \
  /usr/bin/glower-shell
# оболочку закрыли — значит, закончился и сеанс
labwc -e >/dev/null 2>&1 || true
STARTUP
  else
    say "GlowerOS: WebKit недоступен — показываю оболочку браузером"
    cat > "$START_SH" <<STARTUP
#!/bin/sh
"$BROWSER" $(cmdline gpu) --ozone-platform=wayland
labwc -e >/dev/null 2>&1 || true
STARTUP
  fi

  chmod +x "$START_SH"
  labwc -C "${GLOWER_LABWC:-/usr/share/glower/labwc}" -s "$START_SH" >>"$LOG" 2>&1
  code=$?
  say "GlowerOS: labwc завершился с кодом $code"
  return $code
}

run_cage(){
  command -v cage >/dev/null || return 1
  [ "$HAVE_DRI" = yes ] || return 1
  say "GlowerOS: пробую cage (Wayland)"
  cage -- "$BROWSER" $(cmdline gpu) --ozone-platform=wayland >>"$LOG" 2>&1
  code=$?
  say "GlowerOS: cage завершился с кодом $code"
  return $code
}

run_x(){   # $1 — режим отрисовки
  command -v Xorg >/dev/null || command -v X >/dev/null || return 1
  say "GlowerOS: пробую X-сервер ($1)"
  cat > "$HOME/.xinitrc" <<XRC
exec "$BROWSER" $(cmdline "$1")
XRC
  startx "$HOME/.xinitrc" -- :0 vt1 -nolisten tcp >>"$LOG" 2>&1
  code=$?
  say "GlowerOS: X-сервер завершился с кодом $code"
  return $code
}

# Успешный выход — это конец сеанса (оболочку закрыли), а не повод
# перезапускаться следующим способом.
[ "$HAVE_DRI" = yes ] && { run_labwc && exit 0; }
[ "$HAVE_DRI" = yes ] && { run_cage && exit 0; }
[ "$HAVE_DRI" = yes ] && { run_x gpu && exit 0; }
run_x soft && exit 0

# --- сюда попадаем, только если ничего не вышло ---
say ""
say "  GlowerOS не смог показать оболочку на этой машине."
say "  Что известно:"
say "    графический узел: $(ls /dev/dri 2>/dev/null | tr '\n' ' ' || echo 'нет')"
say "    браузер:          $BROWSER"
say "    labwc:            $(command -v labwc || echo 'нет')"
say "    cage:             $(command -v cage || echo 'нет')"
say "    X-сервер:         $(command -v Xorg || command -v X || echo 'нет')"
say "  Подробности: $LOG"
say "  Войти в систему можно на другой консоли: Ctrl+Alt+F2, пользователь glower"
say ""
sleep infinity
