#!/bin/sh
# ==========================================================================
#  Сеанс GlowerOS: агент, оконный сервер labwc и панель.
#
#  Весь рабочий стол — одна своя программа, glower-panel: стол с обоями и
#  значками, полоса наверху, док, меню, уведомления. Браузерного движка в
#  сеансе нет вовсе.
#
#  labwc поднимается одним из двух способов:
#    1) прямо на видеокарте — обычный путь;
#    2) внутри X-сервера с программной отрисовкой — для старых машин, где
#       ядро не берёт на себя видеокарту и узла /dev/dri нет.
#  Если не вышло ничего — на экране остаётся понятное объяснение, а не
#  мигающий курсор.
# ==========================================================================
set -e

# Особые права ядра сеансу не нужны, а песочнице flatpak они прямо мешают:
# она отказывается работать, если у позвавшего есть права, но он не setuid.
# Юнит их уже снимает; здесь — на случай запуска сеанса иным способом.
if [ -z "${GLOWER_NO_CAPS:-}" ] && command -v setpriv >/dev/null 2>&1; then
  GLOWER_NO_CAPS=1
  export GLOWER_NO_CAPS
  exec setpriv --ambient-caps=-all --inh-caps=-all "$0" "$@"
fi

# Настоящим программам Linux нужна общая шина сеанса: через неё работают
# уведомления, портал выбора файлов и песочница flatpak. Без неё программы
# запускаются, но ведут себя странно и молча. Поднимаем её на весь сеанс.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
  exec dbus-run-session -- "$0" "$@"
fi

# Настоящая раскладка клавиатуры — для чужих программ.
#
# Наша оболочка переключает язык сама, внутри своих страниц. Firefox и
# терминал живут снаружи, и для них язык задаёт оконный сервер: какую
# раскладку он получил при запуске, такая и будет до конца сеанса. Пока
# здесь ничего не стояло, в браузере нельзя было набрать ни одной русской
# буквы — и починить это изнутри системы человек не мог никак.
#
# Две раскладки и переключение по Alt+Shift — то же сочетание, по которому
# переключается наша собственная. Нажатие видят обе, и они не расходятся.
# Свои настройки чужим программам — своим каталогом, а не подменой их
# файлов. Первым в списке идёт наш: foot берёт из него foot.ini, и при этом
# ничей файл не тронут. Подменять чужое нельзя не из вежливости, а потому
# что файлом владеет его пакет: наш пакет не смог бы такой файл поставить.
XDG_CONFIG_DIRS="/usr/share/glower/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"
export XDG_CONFIG_DIRS

# Язык программ Linux. Свой интерфейс система переводит сама, а Firefox,
# Thunar и прочие берут язык из LANG. Выбор пишет агент в
# ~/.config/glower/locale; берём его, только если такая локаль в системе
# действительно собрана — иначе программы ругались бы на каждом запуске.
if [ -r "$HOME/.config/glower/locale" ]; then
  LOC_USER="$(head -n1 "$HOME/.config/glower/locale" | tr -d ' \r')"
  case "$LOC_USER" in
    [a-z][a-z]_[A-Z][A-Z].UTF-8)
      LOC_SHORT="$(printf '%s' "$LOC_USER" | sed 's/\.UTF-8$/.utf8/')"
      if locale -a 2>/dev/null | grep -qx "$LOC_SHORT"; then
        LANG="$LOC_USER"; LANGUAGE="${LOC_USER%%.*}"
        export LANG LANGUAGE
      fi ;;
  esac
fi

# Раскладки человек выбирает сам — в начальной настройке и в «Параметрах»;
# агент записывает выбор в ~/.config/glower/keyboard строкой вида «us,ru,de».
# Читаем его осторожно: в строке только имена раскладок XKB через запятую,
# не больше четырёх (больше XKB держать разом не умеет). Испорченный файл
# не должен оставить человека без клавиатуры — тогда берём привычное.
KB_USER=""
if [ -r "$HOME/.config/glower/keyboard" ]; then
  KB_USER="$(head -n1 "$HOME/.config/glower/keyboard" | tr -d ' \r')"
  case "$KB_USER" in
    *[!a-z0-9,]*|"") KB_USER="" ;;
  esac
  [ "$(printf '%s' "$KB_USER" | tr -cd ',' | wc -c)" -le 3 ] || KB_USER=""
fi
XKB_DEFAULT_LAYOUT="${GLOWER_KB_LAYOUT:-${KB_USER:-us,ru}}"
XKB_DEFAULT_OPTIONS="${GLOWER_KB_OPTIONS:-grp:alt_shift_toggle}"
export XKB_DEFAULT_LAYOUT XKB_DEFAULT_OPTIONS

ROOT="${GLOWER_ROOT:-$HOME/GlowerOS}"
PORT="${GLOWER_PORT:-8123}"
UI="${GLOWER_UI:-/usr/share/glower/ui}"
FLAGS="${GLOWER_FLAGS:---system --allow-open --allow-launch --allow-power --allow-install --allow-net --allow-packages}"
LOG="${GLOWER_LOG:-/var/log/glower-session.log}"

mkdir -p "$ROOT"
touch "$LOG" 2>/dev/null || LOG="$HOME/glower-session.log"

# Свои сообщения пишем в журнал, а не на экран. На консоль они попадали
# всегда, и между экраном входа и рабочим столом человек успевал увидеть
# чёрный экран с бегущими строками — ровно то, от чего мы уходили заставкой.
# Кому нужны подробности, тот запустит сеанс с GLOWER_DEBUG.
say(){
  [ -n "${GLOWER_DEBUG:-}" ] && printf '%s\n' "$1"
  printf '%s\n' "$1" >> "$LOG" 2>/dev/null || true
}

# --- хранилище паролей ---
# Если вход не отпер его сам (живой носитель, где пароля ни у кого нет),
# поднимаем службу здесь: без неё программам негде держать свои ключи, и
# каждая заводит собственный тайник на диске открытым текстом.
# Пустой пароль допустим ровно в одном месте — на живом носителе, где
# пароля нет ни у кого. Там просто запустить службу мало: она поднимется,
# но замок останется закрытым, и первая же программа, решившая сохранить
# пароль, повиснет навсегда, ожидая окно с вопросом, которого никто не
# покажет.
#
# На установленной системе так делать нельзя, и раньше здесь была ровно
# эта ошибка: условие «PAM не поднял службу» выполнялось и на диске тоже,
# хранилище заводилось с пустым паролем, а на следующем входе PAM пытался
# открыть его настоящим паролем человека и не мог — в журнале оставалось
# «gkr-pam: couldn't unlock the login keyring». Поэтому теперь отличаем
# носитель от установленной системы явно, тем же признаком, что и всюду.
if command -v gnome-keyring-daemon >/dev/null 2>&1 && [ -z "${GNOME_KEYRING_CONTROL:-}" ]; then
  if [ -d /run/live/medium ] || [ -d /cdrom/live ]; then
    # Живой носитель: пароля нет ни у кого, отпираем пустым.
    eval "$(printf '' | gnome-keyring-daemon --unlock --components=secrets,ssh 2>/dev/null | sed 's/^/export /')" || \
    eval "$(gnome-keyring-daemon --start --components=secrets,ssh 2>/dev/null | sed 's/^/export /')" || true
  else
    # Установленная система: только поднимаем службу, замок не трогаем.
    eval "$(gnome-keyring-daemon --start --components=secrets,ssh 2>/dev/null | sed 's/^/export /')" || true
  fi
fi

# Права по запросу. polkitd в системе есть, но сам он ничего не спрашивает:
# он лишь решает, кому что можно, и ждёт, что пароль у человека попросит
# кто-то другой — агент проверки подлинности. Без него любая программа,
# которой нужны права, получает молчаливый отказ. Ни окна, ни ошибки: она
# просто не делает того, о чём её попросили.
#
# Проявляется это неочевидно. Например, VPN-клиент не может включить режим
# туннеля: создать сетевой интерфейс и переписать маршруты обычному
# пользователю нельзя, а спросить разрешения не у кого. Человек видит
# переключатель, который не включается, и никаких объяснений.
find_polkit_agent(){
  [ -n "${GLOWER_NO_POLKIT:-}" ] && return 1
  for a in \
    /usr/lib/*/polkit-mate/polkit-mate-authentication-agent-1 \
    /usr/libexec/polkit-mate-authentication-agent-1 \
    /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 \
    /usr/lib/*/libexec/polkit-gnome-authentication-agent-1 \
    /usr/bin/lxqt-policykit-agent
  do
    [ -x "$a" ] || continue
    printf '%s\n' "$a"
    return 0
  done
  return 1
}

# Агенту нужен уже поднятый экран, иначе ему негде показать своё окно.
# Поэтому путь мы находим здесь, а запускаем его из стартового скрипта —
# рядом с оболочкой, когда оконный сервер уже готов.
POLKIT_AGENT="$(find_polkit_agent || true)"
if [ -n "$POLKIT_AGENT" ]; then
  say "GlowerOS: агент прав — $POLKIT_AGENT"
else
  say "GlowerOS: агента прав нет — программы не смогут попросить у системы разрешение"
fi

# Системный лоток. Программы кладут туда значки не сами по себе: они
# объявляют себя на шине и ждут, что кто-то отзовётся приёмником. Нет
# приёмника — нет значка, и сворачиваться программе некуда. Именно поэтому
# Telegram при закрытии окна уходил у нас совсем.
if [ -x /usr/bin/glower-tray ]; then
  /usr/bin/glower-tray >>"$LOG" 2>&1 &
  say "GlowerOS: glower-tray — принимаю значки программ в лоток"
fi

# Программы Windows открываются двойным щелчком — нашим glower-exe.
# В образе это записано в общий список ассоциаций, но машины, поставленные
# раньше, получают glower-exe с обновлением, а общий список обновление не
# трогает: он собирается при сборке образа. Поэтому записываем
# ассоциацию человеку — один раз и только если её там ещё нет. Строки
# кладём сразу под заголовок: если человек сам выбрал, чем открывать .exe,
# его строка стоит ниже и побеждает.
USER_MIME="$HOME/.config/mimeapps.list"
if [ -f /usr/share/applications/glower-exe.desktop ] && \
   ! grep -q '=glower-exe.desktop' "$USER_MIME" 2>/dev/null; then
  EXE_LINES='application/x-ms-dos-executable=glower-exe.desktop
application/x-msdownload=glower-exe.desktop
application/vnd.microsoft.portable-executable=glower-exe.desktop
application/x-ms-ne-executable=glower-exe.desktop
application/x-msi=glower-exe.desktop
application/x-ms-shortcut=glower-exe.desktop'
  export EXE_LINES
  mkdir -p "$HOME/.config" 2>/dev/null
  if grep -q '^\[Default Applications\]' "$USER_MIME" 2>/dev/null; then
    awk '{ print } /^\[Default Applications\]/ && !done { print ENVIRON["EXE_LINES"]; done = 1 }' \
      "$USER_MIME" > "$USER_MIME.new" && mv "$USER_MIME.new" "$USER_MIME"
  else
    printf '[Default Applications]\n%s\n' "$EXE_LINES" >> "$USER_MIME"
  fi
  say "GlowerOS: программы Windows открываются через glower-exe"
fi

# --- агент: мост между панелью и машиной ---
node "$UI/agent/server.mjs" --port "$PORT" --root "$ROOT" $FLAGS >>"$LOG" 2>&1 &
AGENT=$!
trap 'kill $AGENT 2>/dev/null' EXIT INT TERM

i=0
while [ $i -lt 50 ]; do
  curl -sf "http://localhost:$PORT/" >/dev/null 2>&1 && break
  i=$((i+1)); sleep 0.2
done

HAVE_DRI=no
ls /dev/dri/card* >/dev/null 2>&1 && HAVE_DRI=yes
[ "$HAVE_DRI" = yes ] || say "GlowerOS: видеоускорения нет — облегчённый режим"

# Ни один способ не запускаем через exec: если он не заведётся именно на
# этой машине, сеанс должен пережить отказ и попробовать следующий.

# Что запускает оконный сервер: панель, а упадёт — поднимает её снова.
# Пять падений за полминуты — это уже не случайность: тогда сеанс
# заканчивается, и служба входа показывает экран входа, а не пустоту.
# $1 — что сделать перед панелью (размер вложенного экрана под X).
write_start(){
  mkdir -p "$HOME/.local/share/glower"
  START_SH="$HOME/.local/share/glower/shell.sh"
  cat > "$START_SH" <<STARTUP
#!/bin/sh
$1
# окно с вопросом «разрешить?» показывает он — без него запросы прав
# проваливаются молча
[ -n "$POLKIT_AGENT" ] && "$POLKIT_AGENT" >/dev/null 2>&1 &
GLOWER_URL="http://localhost:$PORT/"
GLOWER_PORT="$PORT"
export GLOWER_URL GLOWER_PORT
falls=0
since=\$(date +%s)
while :; do
  /usr/bin/glower-panel
  now=\$(date +%s)
  if [ \$((now - since)) -gt 30 ]; then falls=0; since=\$now; fi
  falls=\$((falls + 1))
  [ \$falls -ge 5 ] && break
  sleep 1
done
# Конец сеанса — тому серверу, под которым он шёл
if [ -n "\${GLOWER_WM_PID:-}" ]; then glower-wm -e >/dev/null 2>&1 || true; else labwc -e >/dev/null 2>&1 || true; fi
STARTUP
  chmod +x "$START_SH"
}

# Гасит повторяющиеся сообщения. Считать «подряд идущие» здесь мало: в
# настоящем журнале две строки про LVDS чередуются, и подряд одинаковых нет
# ни одной. Поэтому считаем каждое сообщение отдельно: первые три раза
# показываем целиком, дальше молчим и лишь на круглых числах — 10, 100,
# 1000 — печатаем строку со счётчиком. Так видно и что это было, и сколько
# его набралось, а журнал остаётся читаемым.
#
# Время в начале строки при сравнении отбрасываем: у повторов оно разное, а
# сообщение одно и то же. Имена внутри awk — латиницей: кириллицу в именах
# awk не принимает, и это уже стоило нам трёх поломок.
fold_repeats(){
  awk '
    function key_of(s) {
      sub(/^[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\.[0-9]+ /, "", s)
      return s
    }
    {
      k = key_of($0)
      seen[k]++
      if (seen[k] <= 3) { print; fflush(); next }
      if (seen[k] == 10 || seen[k] == 100 || seen[k] == 1000 || seen[k] == 10000) {
        printf "  ... это сообщение повторилось %d раз, дальше молчу: %s\n", seen[k], k
        fflush()
      }
    }
    END {
      for (k in seen)
        if (seen[k] > 3)
          printf "  ... всего повторов за сеанс: %d — %s\n", seen[k], k
    }
  '
}

# Папка настроек оконного сервера на сеанс (см. комментарий в run_labwc)
prepare_wm_dir(){
  LABWC_SYS="${GLOWER_LABWC:-/usr/share/glower/labwc}"
  LABWC_DIR="${XDG_RUNTIME_DIR:-/tmp}/glower-labwc"
  if mkdir -p "$LABWC_DIR" 2>/dev/null && [ ! -L "$LABWC_DIR/environment" ]; then
    for f in "$LABWC_SYS"/*; do
      [ -e "$f" ] || continue
      [ "$(basename "$f")" = environment ] && continue
      ln -sfn "$f" "$LABWC_DIR/$(basename "$f")"
    done
    {
      [ -r "$LABWC_SYS/environment" ] && cat "$LABWC_SYS/environment"
      printf 'XKB_DEFAULT_LAYOUT=%s\nXKB_DEFAULT_OPTIONS=%s\n' "$XKB_DEFAULT_LAYOUT" "$XKB_DEFAULT_OPTIONS"
    } > "$LABWC_DIR/environment"
  else
    LABWC_DIR="$LABWC_SYS"
  fi
}

run_labwc(){
  command -v labwc >/dev/null || return 1
  [ "$HAVE_DRI" = yes ] || return 1
  say "GlowerOS: пробую labwc (Wayland)"

  # Чужие программы должны знать, куда они попали. Без этого Qt по привычке
  # идёт через X11, упирается в «could not connect to display» и молча
  # заканчивается — даже когда умеет Wayland и его поддержка тут же рядом.
  # Список через точку с запятой Qt понимает как «сначала первое, потом
  # второе»: своим ходом по Wayland, а кто не умеет — через Xwayland.
  XDG_SESSION_TYPE=wayland
  XDG_CURRENT_DESKTOP=labwc
  QT_QPA_PLATFORM='wayland;xcb'
  # Firefox от Mozilla, увидев DISPLAY, по умолчанию идёт старым путём через
  # X11 — даже когда рядом есть Wayland, который он прекрасно умеет. Пока
  # Xwayland в образ не входил, DISPLAY не было, и выбора у него тоже не
  # было: он работал напрямую и всё шло хорошо. Стоило нам починить X11 для
  # чужих программ, как Firefox перестал запускаться вовсе — на старой
  # видеокарте его путь через X11 не едет. Поэтому говорим прямо.
  MOZ_ENABLE_WAYLAND=1
  export XDG_SESSION_TYPE XDG_CURRENT_DESKTOP QT_QPA_PLATFORM MOZ_ENABLE_WAYLAND

  write_start ""

  # Экран этой машины labwc отдаёт не с первого раза: на старых Intel с
  # матрицей LVDS атомарная установка режима возвращает EBUSY, wlroots
  # повторяет попытку, и в журнал сыплется «Atomic commit failed» — по
  # десятку строк в секунду. Картинка при этом живёт (повтор срабатывает),
  # а вот журнал превращается в мусор: полезные строки вымывает за минуту,
  # и разбирать по нему уже нечего. Поэтому:
  #   1) на машинах с LVDS просим wlroots не пользоваться атомарным путём —
  #      старый работает там без сбоев;
  #   2) что всё-таки повторяется, сворачиваем в одну строку со счётчиком.
  if ls -d /sys/class/drm/*LVDS* >/dev/null 2>&1; then
    say "GlowerOS: матрица LVDS — переключаю вывод на неатомарный путь"
    WLR_DRM_NO_ATOMIC=1
    export WLR_DRM_NO_ATOMIC
  fi

  # Своя папка настроек labwc на время сеанса: те же файлы, что в системе
  # (ссылками), и рядом файл environment с раскладками. labwc перечитывает
  # его по команде перенастройки — так агент меняет раскладки, не трогая
  # системную папку, в которую человеку писать нельзя. Сам environment —
  # всегда свой файл, не ссылка: иначе запись ушла бы в системный. Не
  # вышло завести папку — работаем прямо от системной, как раньше.
  prepare_wm_dir

  STATUS="$HOME/.local/share/glower/labwc.code"
  rm -f "$STATUS"
  {
    labwc -C "$LABWC_DIR" -s "$START_SH" 2>&1
    echo $? > "$STATUS"
  } | fold_repeats >> "$LOG"
  code="$(cat "$STATUS" 2>/dev/null || echo 0)"
  say "GlowerOS: labwc завершился с кодом $code"
  return "$code"
}

# Старые машины часто не дают ядру управлять видеокартой: узла /dev/dri нет,
# и прямо на видеокарте Wayland не поднимется. X-сервер работает и там —
# простым способом, который понимает почти любое железо. Внутри него тот же
# labwc, на программной отрисовке, окном во весь экран: рабочий стол тот же
# самый, слои и панель на месте.
run_x(){
  command -v Xorg >/dev/null || command -v X >/dev/null || return 1
  command -v labwc >/dev/null || return 1
  say "GlowerOS: пробую labwc внутри X-сервера"

  XDG_SESSION_TYPE=wayland
  XDG_CURRENT_DESKTOP=labwc
  QT_QPA_PLATFORM='wayland;xcb'
  MOZ_ENABLE_WAYLAND=1
  export XDG_SESSION_TYPE XDG_CURRENT_DESKTOP QT_QPA_PLATFORM MOZ_ENABLE_WAYLAND

  # Вложенный экран labwc открывает окном своего размера; растягиваем его
  # на весь экран X-сервера, как только поднялся
  write_start 'command -v wlr-randr >/dev/null && [ -n "$GLOWER_X_SIZE" ] && wlr-randr --output X11-1 --custom-mode "$GLOWER_X_SIZE" >/dev/null 2>&1'
  cat > "$HOME/.xinitrc" <<XRC
# X-сервер переменных XKB_DEFAULT_* не знает, а labwc внутри него — знает
GLOWER_X_SIZE=\$(xdpyinfo 2>/dev/null | awk '/dimensions:/ { print \$2; exit }')
export GLOWER_X_SIZE
WLR_BACKENDS=x11 WLR_RENDERER=pixman WLR_RENDERER_ALLOW_SOFTWARE=1 \\
  exec labwc -C "${GLOWER_LABWC:-/usr/share/glower/labwc}" -s "$START_SH"
XRC
  startx "$HOME/.xinitrc" -- :0 vt1 -nolisten tcp >>"$LOG" 2>&1
  code=$?
  say "GlowerOS: X-сервер завершился с кодом $code"
  return $code
}

# Свой оконный сервер (glower-wm) — по выбору в «Параметрах», пока как
# проба: с размытием и анимациями, но ещё молодой. Если он не поднялся
# или упал в первые секунды — сеанс сам продолжается под labwc, и человек
# видит рабочий стол, а не чёрный экран. Выбор лежит в настройках панели:
# "wm": "glower".
wants_glower_wm(){
  command -v glower-wm >/dev/null 2>&1 || return 1
  grep -qE '"wm"[[:space:]]*:[[:space:]]*"glower"' "$HOME/.config/glower/settings.json" 2>/dev/null
}

run_glower_wm(){
  [ "$HAVE_DRI" = yes ] || return 1
  wants_glower_wm || return 1
  say "GlowerOS: пробую glower-wm (свой оконный сервер)"
  XDG_SESSION_TYPE=wayland
  XDG_CURRENT_DESKTOP=GlowerOS:wlroots
  QT_QPA_PLATFORM='wayland;xcb'
  MOZ_ENABLE_WAYLAND=1
  export XDG_SESSION_TYPE XDG_CURRENT_DESKTOP QT_QPA_PLATFORM MOZ_ENABLE_WAYLAND
  write_start ""
  # Та же папка настроек, что у labwc: rc.xml и environment с раскладками
  prepare_wm_dir
  WM_DIR="$LABWC_DIR"
  started=$(date +%s)
  STATUS="$HOME/.local/share/glower/wm.code"
  rm -f "$STATUS"
  {
    glower-wm -C "$WM_DIR" -s "$START_SH" 2>&1
    echo $? > "$STATUS"
  } | fold_repeats >> "$LOG"
  code="$(cat "$STATUS" 2>/dev/null || echo 1)"
  lived=$(( $(date +%s) - started ))
  say "GlowerOS: glower-wm завершился с кодом $code через $lived с"
  # Нормальный выход (человек вышел из сеанса) — конец. Упал быстро —
  # пусть дальше работает labwc
  [ "$code" = 0 ] && return 0
  [ "$lived" -lt 20 ] && return 1
  return "$code"
}

# Успешный выход — это конец сеанса (оболочку закрыли), а не повод
# перезапускаться следующим способом.
[ "$HAVE_DRI" = yes ] && { run_glower_wm && exit 0; }
[ "$HAVE_DRI" = yes ] && { run_labwc && exit 0; }
# Видеоузла нет или labwc на нём не пошёл — через X-сервер: так старые
# машины всё равно показывают рабочий стол, а не чёрный экран.
run_x && exit 0

# --- сюда попадаем, только если ничего не вышло ---
say ""
say "  GlowerOS не смог показать оболочку на этой машине."
say "  Что известно:"
say "    графический узел: $(ls /dev/dri 2>/dev/null | tr '\n' ' ' || echo 'нет')"
say "    панель:           $(command -v glower-panel || echo 'нет')"
say "    labwc:            $(command -v labwc || echo 'нет')"
say "    X-сервер:         $(command -v Xorg || command -v X || echo 'нет')"
say "  Подробности: $LOG"
say "  Войти в систему можно на другой консоли: Ctrl+Alt+F2, пользователь glower"
say ""
sleep infinity
