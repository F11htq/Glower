#!/bin/sh
# ==========================================================================
#  Просит оболочку открыть меню программ — по одной клавише Win.
#
#  Клавишу человек жмёт из любой программы, а клавиши достаются окну в
#  фокусе: стоило открыть браузер, и Win до оболочки не доходил вовсе.
#  Поэтому клавишу держит оконный сервер, а он зовёт эту программу — она
#  только передаёт просьбу, как это делает glower-shot.
#
#  Отдельная забота — сочетания. Win приходит первой и в Win+Shift+S, и в
#  Win+D: оконный сервер этой сборки умеет ловить клавишу только на
#  нажатии, а на нажатии ещё неизвестно, одна она или начало сочетания.
#  Поэтому меню ждёт четверть секунды: если за это время пришло сочетание —
#  оно оставляет отметку, и меню молча уходит. Ждать дольше человек уже
#  заметит, меньше — не успеет прийти вторая клавиша.
#
#  Имена переменных латиницей: dash кириллицу в именах не принимает.
# ==========================================================================
set -eu

MARK="${XDG_RUNTIME_DIR:-/tmp}/glower-combo"

# Отметку ставит сочетание — тем же сценарием, вторым действием в той же
# привязке. Своего кода для этого не нужно: файл и есть всё сообщение.
if [ "${1:-}" = "отмени" ] || [ "${1:-}" = "combo" ]; then
  : > "$MARK" 2>/dev/null || true
  exit 0
fi

PORT="${GLOWER_PORT:-8123}"
URL="http://127.0.0.1:$PORT/rpc"

# «замок» — Win+L из любой программы. Запирает агент: он знает, какой
# программой блокировки пользоваться под этим сеансом, и не запустит
# вторую, если экран уже заперт.
if [ "${1:-}" = "замок" ]; then
  : > "$MARK" 2>/dev/null || true
  command -v curl >/dev/null 2>&1 || { echo "в системе нет curl" >&2; exit 1; }
  curl -sf -m 5 -X POST -H 'Content-Type: application/json' \
    -d '{"method":"sys.power","params":{"action":"lock"}}' "$URL" >/dev/null
  exit $?
fi

# «клавиша A-F4» — сочетание, которое оконный сервер поймал на рабочем
# столе. Окна системы — Параметры, Магазин, Проводник — живут внутри
# страницы стола, и для оконного сервера все они одно окно. Alt+F4 он
# честно отправлял этому окну, стол просьбу отклонял (закрыть стол
# нельзя), и до страницы клавиша не доходила вовсе: человек жал Alt+F4 на
# открытых Параметрах — и ничего. Теперь на столе сервер передаёт
# сочетание сюда, а мы — странице: она знает, какое из её окон сверху.
if [ "${1:-}" = "клавиша" ]; then
  : > "$MARK" 2>/dev/null || true
  COMBO="${2:-}"
  # В сочетании только латиница, цифры и дефис — в строку JSON его можно
  # вставить как есть.
  case "$COMBO" in ''|*[!A-Za-z0-9-]*) echo "непонятное сочетание: $COMBO" >&2; exit 2 ;; esac
  command -v curl >/dev/null 2>&1 || { echo "в системе нет curl" >&2; exit 1; }
  curl -sf -m 3 -X POST -H 'Content-Type: application/json' \
    -d '{"method":"ui.say","params":{"тема":"клавиша","что":"'"$COMBO"'"}}' "$URL" >/dev/null
  exit $?
fi
# «переключи», а не «открой»: второе нажатие Win должно закрывать меню, а
# не открывать его заново. Решает это стол — он один знает, открыто ли оно.
BODY='{"method":"ui.say","params":{"тема":"открой-пуск","что":"переключи"}}'

rm -f "$MARK" 2>/dev/null || true
sleep 0.25
[ -e "$MARK" ] && exit 0

# Меню рисует оболочка, а её окно лежит под чужими: открой браузер во весь
# экран — и меню откроется за ним. Человек нажал Win и не увидел ничего.
# Поэтому сперва поднимаем оболочку, как это делает Win+D.
#
# Нативному меню (glower-panel) это не нужно: оно своё, поверх всех окон.
# Поднять стол тогда значило бы спрятать за ним программу, в которой
# человек работал, — закрыл меню, а она уже позади.
NATIVE=$(curl -sf -m 2 -X POST -H 'Content-Type: application/json' \
  -d '{"method":"ui.last","params":{"тема":"обзор-свой"}}' "$URL" 2>/dev/null || true)
case "$NATIVE" in
  *'"что":true'*) ;;
  *) if command -v wlrctl >/dev/null 2>&1; then
       wlrctl toplevel focus app_id:glowershell >/dev/null 2>&1 || true
     fi ;;
esac

command -v curl >/dev/null 2>&1 || { echo "в системе нет curl" >&2; exit 1; }
curl -sf -m 5 -X POST -H 'Content-Type: application/json' -d "$BODY" "$URL" >/dev/null || {
  echo "оболочка не отвечает — открывать меню некому" >&2; exit 1; }
