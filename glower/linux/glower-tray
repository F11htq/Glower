#!/usr/bin/env python3
"""Системный лоток: приёмник значков программ.

Программы не кладут значки куда попало. Они объявляют себя по общему уговору
— StatusNotifierItem поверх шины D-Bus — и ждут, что кто-то отзовётся
приёмником. Нет приёмника — нет значка, и сворачиваться программе некуда:
именно поэтому Telegram при закрытии окна уходил у нас совсем.

Эта служба и есть приёмник. Она ведёт список пришедших, читает у каждого имя,
вид и картинку и складывает всё в один файл, который читает агент. Рисует
оболочка, а нажатия обратно программе отправляет агент.

Почему протокол разобран здесь руками, а не взят готовым. Обычно для этого
берут python3-gi или python3-dbus. Обе — двоичные надстройки, и обе ломаются
вместе с обновлением Python; на машине сборки они в тот день просто не
работали, и проверить службу было бы нечем. Проверять же её надо: два
предыдущих раза я отдавал непроверенное, и оба раза это стоило чужого
времени. Здесь весь разговор — обычные байты в обычный сокет, и его целиком
можно прогнать на настоящей шине, не имея ничего, кроме Python.

Имена внутри кириллицей: Python их принимает. Латиницей — только то, что
уходит наружу: имена на шине, ключи файла, путь к нему.
"""
import json
import os
import socket
import struct
import sys
import tempfile
import zlib

ИМЯ_НАБЛЮДАТЕЛЯ = 'org.kde.StatusNotifierWatcher'
ПУТЬ_НАБЛЮДАТЕЛЯ = '/StatusNotifierWatcher'
ЛИЦО_ЗНАЧКА = 'org.kde.StatusNotifierItem'


# ==========================================================================
# Разбор подписей: «a{sv}» — это массив словарей, «(iiay)» — тройка, и так
# далее. Нужно уметь отделить один полный тип от следующего.
# ==========================================================================
def раздели_подпись(п):
    части, i = [], 0
    while i < len(п):
        начало = i
        while п[i] == 'a':
            i += 1
        if п[i] in '({':
            закрывающая = ')' if п[i] == '(' else '}'
            открывающая = п[i]
            глубина = 0
            while True:
                if п[i] == открывающая:
                    глубина += 1
                elif п[i] == закрывающая:
                    глубина -= 1
                    if глубина == 0:
                        break
                i += 1
        i += 1
        части.append(п[начало:i])
    return части


ВЫРАВНИВАНИЕ = {'y': 1, 'b': 4, 'n': 2, 'q': 2, 'i': 4, 'u': 4, 'x': 8, 't': 8,
                'd': 8, 's': 4, 'o': 4, 'g': 1, 'a': 4, 'v': 1, 'h': 4}


def выравнивание(тип):
    if тип[0] in '({':
        return 8
    return ВЫРАВНИВАНИЕ.get(тип[0], 1)


class Пишу:
    def __init__(с):
        с.б = bytearray()

    def ровно(с, до):
        пока = (-len(с.б)) % до
        с.б += b'\0' * пока

    def значение(с, тип, з):
        т = тип[0]
        if т == 'y':
            с.б += struct.pack('<B', з & 0xFF)
        elif т == 'b':
            с.ровно(4); с.б += struct.pack('<I', 1 if з else 0)
        elif т in 'nq':
            с.ровно(2); с.б += struct.pack('<h' if т == 'n' else '<H', з)
        elif т in 'iuh':
            с.ровно(4); с.б += struct.pack('<i' if т == 'i' else '<I', з)
        elif т in 'xt':
            с.ровно(8); с.б += struct.pack('<q' if т == 'x' else '<Q', з)
        elif т == 'd':
            с.ровно(8); с.б += struct.pack('<d', з)
        elif т in 'so':
            д = з.encode()
            с.ровно(4); с.б += struct.pack('<I', len(д)) + д + b'\0'
        elif т == 'g':
            д = з.encode()
            с.б += struct.pack('<B', len(д)) + д + b'\0'
        elif т == 'v':
            подпись, значение = з
            с.значение('g', подпись)
            с.значение(подпись, значение)
        elif т == 'a':
            внутри = тип[1:]
            с.ровно(4)
            место = len(с.б)
            с.б += b'\0\0\0\0'
            с.ровно(выравнивание(внутри))
            начало = len(с.б)
            if внутри[0] == '{':
                ключ, знач = раздели_подпись(внутри[1:-1])
                for к, в in з.items():
                    с.ровно(8)
                    с.значение(ключ, к)
                    с.значение(знач, в)
            else:
                for э in з:
                    с.значение(внутри, э)
            длина = len(с.б) - начало
            с.б[место:место + 4] = struct.pack('<I', длина)
        elif т == '(':
            с.ровно(8)
            for подтип, э in zip(раздели_подпись(тип[1:-1]), з):
                с.значение(подтип, э)
        else:
            raise ValueError('не умею писать тип ' + тип)


class Читаю:
    def __init__(с, б, поз=0):
        с.б, с.поз = б, поз

    def ровно(с, до):
        с.поз += (-с.поз) % до

    def значение(с, тип):
        т = тип[0]
        if т == 'y':
            з = с.б[с.поз]; с.поз += 1; return з
        if т == 'b':
            с.ровно(4); з = struct.unpack_from('<I', с.б, с.поз)[0]; с.поз += 4; return bool(з)
        if т in 'nq':
            с.ровно(2)
            з = struct.unpack_from('<h' if т == 'n' else '<H', с.б, с.поз)[0]; с.поз += 2; return з
        if т in 'iuh':
            с.ровно(4)
            з = struct.unpack_from('<i' if т == 'i' else '<I', с.б, с.поз)[0]; с.поз += 4; return з
        if т in 'xt':
            с.ровно(8)
            з = struct.unpack_from('<q' if т == 'x' else '<Q', с.б, с.поз)[0]; с.поз += 8; return з
        if т == 'd':
            с.ровно(8); з = struct.unpack_from('<d', с.б, с.поз)[0]; с.поз += 8; return з
        if т in 'so':
            с.ровно(4)
            n = struct.unpack_from('<I', с.б, с.поз)[0]; с.поз += 4
            з = с.б[с.поз:с.поз + n].decode('utf-8', 'replace'); с.поз += n + 1
            return з
        if т == 'g':
            n = с.б[с.поз]; с.поз += 1
            з = с.б[с.поз:с.поз + n].decode(); с.поз += n + 1
            return з
        if т == 'v':
            подпись = с.значение('g')
            return с.значение(подпись)
        if т == 'a':
            внутри = тип[1:]
            с.ровно(4)
            n = struct.unpack_from('<I', с.б, с.поз)[0]; с.поз += 4
            с.ровно(выравнивание(внутри))
            конец = с.поз + n
            if внутри[0] == '{':
                ключ, знач = раздели_подпись(внутри[1:-1])
                итог = {}
                while с.поз < конец:
                    с.ровно(8)
                    к = с.значение(ключ)
                    итог[к] = с.значение(знач)
                return итог
            # Массив байтов отдаём как есть: это картинка, а не список чисел.
            if внутри == 'y':
                з = bytes(с.б[с.поз:конец]); с.поз = конец; return з
            итог = []
            while с.поз < конец:
                итог.append(с.значение(внутри))
            return итог
        if т == '(':
            с.ровно(8)
            return tuple(с.значение(п) for п in раздели_подпись(тип[1:-1]))
        raise ValueError('не умею читать тип ' + тип)


# ==========================================================================
# Сообщения шины
# ==========================================================================
ВЫЗОВ, ОТВЕТ, ОШИБКА, СИГНАЛ = 1, 2, 3, 4
ПОЛЯ = {1: 'o', 2: 's', 3: 's', 4: 's', 5: 'u', 6: 's', 7: 's', 8: 'g', 9: 'u'}


def собери(тип, поля, подпись='', доводы=(), номер=1, флаги=0):
    тело = Пишу()
    for т, з in zip(раздели_подпись(подпись), доводы):
        тело.значение(т, з)
    тело = bytes(тело.б)

    шапка = Пишу()
    шапка.б += struct.pack('<BBBB', ord('l'), тип, флаги, 1)
    шапка.б += struct.pack('<II', len(тело), номер)
    полный = dict(поля)
    if подпись:
        полный[8] = подпись
    шапка.значение('a(yv)', [(к, (ПОЛЯ[к], з)) for к, з in sorted(полный.items())])
    шапка.ровно(8)
    return bytes(шапка.б) + тело


def разбери(данные):
    """Возвращает (сообщение, сколько байт съедено) или (None, 0)."""
    if len(данные) < 16:
        return None, 0
    порядок, тип, флаги, _в = struct.unpack_from('<BBBB', данные, 0)
    если_чужой = порядок != ord('l')
    if если_чужой:
        raise ValueError('шина ответила в чужом порядке байтов')
    длина_тела, номер = struct.unpack_from('<II', данные, 4)
    ч = Читаю(данные, 12)
    поля_сырые = ч.значение('a(yv)')
    ч.ровно(8)
    начало_тела = ч.поз
    всего = начало_тела + длина_тела
    if len(данные) < всего:
        return None, 0
    # При записи вариант — пара «подпись и значение», при чтении возвращается
    # только значение: подпись уже сделала своё дело. Здесь именно значение.
    поля = {к: з for к, з in поля_сырые}
    подпись = поля.get(8, '')
    тело = []
    if подпись:
        чт = Читаю(данные[начало_тела:всего])
        for т in раздели_подпись(подпись):
            тело.append(чт.значение(т))
    return {'тип': тип, 'номер': номер, 'поля': поля, 'тело': тело}, всего


class Шина:
    def __init__(с, адрес=None):
        адрес = адрес or os.environ.get('DBUS_SESSION_BUS_ADDRESS', '')
        путь = ''
        for кусок in адрес.split(','):
            if кусок.startswith('unix:path='):
                путь = кусок.split('=', 1)[1]
            elif кусок.startswith('unix:abstract='):
                путь = '\0' + кусок.split('=', 1)[1].split(',')[0]
        if not путь:
            raise RuntimeError('не нашёл адреса шины сеанса')
        с.сокет = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        с.сокет.connect(путь)
        с.хвост = b''
        с.номер = 0
        с.имя = ''
        с.вход = []
        с.поздоровайся()

    def поздоровайся(с):
        # Опознание: нулевой байт, затем SASL EXTERNAL с нашим uid.
        с.сокет.sendall(b'\0')
        с.сокет.sendall(b'AUTH EXTERNAL ' +
                        ''.join('%02x' % ord(з) for з in str(os.getuid())).encode() + b'\r\n')
        ответ = с.строка()
        if not ответ.startswith('OK'):
            # Некоторые шины пускают и без опознания.
            с.сокет.sendall(b'AUTH ANONYMOUS\r\n')
            ответ = с.строка()
            if not ответ.startswith('OK'):
                raise RuntimeError('шина не пустила: ' + ответ)
        с.сокет.sendall(b'BEGIN\r\n')
        с.имя = с.позови('org.freedesktop.DBus', '/org/freedesktop/DBus',
                         'org.freedesktop.DBus', 'Hello')[0]

    def строка(с):
        буфер = b''
        while not буфер.endswith(b'\r\n'):
            кусок = с.сокет.recv(1)
            if not кусок:
                raise RuntimeError('шина закрылась при опознании')
            буфер += кусок
        return буфер.decode().strip()

    def отправь(с, данные):
        с.сокет.sendall(данные)

    def следующий(с):
        с.номер += 1
        return с.номер

    def прими(с, ждать=True):
        """Одно сообщение из шины или None, если ждать не велено."""
        while True:
            сообщение, съедено = (None, 0)
            if с.хвост:
                сообщение, съедено = разбери(с.хвост)
            if сообщение:
                с.хвост = с.хвост[съедено:]
                return сообщение
            if not ждать:
                с.сокет.setblocking(False)
            try:
                кусок = с.сокет.recv(65536)
            except BlockingIOError:
                return None
            finally:
                с.сокет.setblocking(True)
            if not кусок:
                raise RuntimeError('шина закрылась')
            с.хвост += кусок

    def позови(с, куда, путь, лицо, метод, подпись='', доводы=(), ждать=True):
        н = с.следующий()
        с.отправь(собери(ВЫЗОВ, {1: путь, 2: лицо, 3: метод, 6: куда},
                         подпись, доводы, н))
        if not ждать:
            return None
        while True:
            м = с.прими()
            if м['поля'].get(5) == н:
                if м['тип'] == ОШИБКА:
                    raise RuntimeError(м['поля'].get(4, 'ошибка шины'))
                return м['тело']
            с.вход.append(м)

    def объяви_имя(с, имя):
        """Занять имя на шине. 1 — заняли, 3 — уже занято другим."""
        итог = с.позови('org.freedesktop.DBus', '/org/freedesktop/DBus',
                        'org.freedesktop.DBus', 'RequestName', 'su', (имя, 4))
        return итог[0]

    def слушай(с, правило):
        с.позови('org.freedesktop.DBus', '/org/freedesktop/DBus',
                 'org.freedesktop.DBus', 'AddMatch', 's', (правило,))

    def ответь(с, кому, номер, подпись='', доводы=()):
        с.отправь(собери(ОТВЕТ, {5: номер, 6: кому}, подпись, доводы, с.следующий()))

    def откажи(с, кому, номер, имя_ошибки, текст):
        с.отправь(собери(ОШИБКА, {4: имя_ошибки, 5: номер, 6: кому},
                         's', (текст,), с.следующий()))

    def сигналь(с, путь, лицо, имя, подпись='', доводы=()):
        с.отправь(собери(СИГНАЛ, {1: путь, 2: лицо, 3: имя}, подпись, доводы, с.следующий()))


# ==========================================================================
# Картинка значка: сырые точки -> PNG
#
# Программы присылают значок либо именем из набора («telegram»), либо сырыми
# точками. Точки надо во что-то завернуть, и здесь это делается руками:
# PNG — простой формат, а тащить ради него целую библиотеку значило бы снова получить
# зависимость, которую нечем проверить.
# ==========================================================================
def png_из_точек(ширина, высота, точки_argb):
    if ширина <= 0 or высота <= 0 or len(точки_argb) < ширина * высота * 4:
        return b''
    ряды = bytearray()
    for y in range(высота):
        ряды.append(0)                       # способ предсказания: никакой
        начало = y * ширина * 4
        for x in range(ширина):
            i = начало + x * 4
            а, к, з, с_ = точки_argb[i], точки_argb[i + 1], точки_argb[i + 2], точки_argb[i + 3]
            ряды += bytes((к, з, с_, а))     # ARGB -> RGBA

    def кусок(имя, данные):
        тело = имя + данные
        return struct.pack('>I', len(данные)) + тело + struct.pack('>I', zlib.crc32(тело))

    заголовок = struct.pack('>IIBBBBB', ширина, высота, 8, 6, 0, 0, 0)
    return (b'\x89PNG\r\n\x1a\n'
            + кусок(b'IHDR', заголовок)
            + кусок(b'IDAT', zlib.compress(bytes(ряды), 6))
            + кусок(b'IEND', b''))


def путь_файла():
    дом = os.environ.get('XDG_RUNTIME_DIR') or ('/run/user/%d' % os.getuid())
    if not os.path.isdir(дом):
        дом = tempfile.gettempdir()
    return os.path.join(дом, 'glower-tray.json')


ОПИСАНИЕ = ('<node><interface name="org.kde.StatusNotifierWatcher">'
            '<method name="RegisterStatusNotifierItem"><arg type="s" direction="in"/></method>'
            '<method name="RegisterStatusNotifierHost"><arg type="s" direction="in"/></method>'
            '<property name="RegisteredStatusNotifierItems" type="as" access="read"/>'
            '<property name="IsStatusNotifierHostRegistered" type="b" access="read"/>'
            '<property name="ProtocolVersion" type="i" access="read"/>'
            '<signal name="StatusNotifierItemRegistered"><arg type="s"/></signal>'
            '<signal name="StatusNotifierItemUnregistered"><arg type="s"/></signal>'
            '<signal name="StatusNotifierHostRegistered"/>'
            '</interface></node>')


class Лоток:
    def __init__(с, шина):
        с.шина = шина
        с.значки = {}
        с.файл = путь_файла()

    # ---------- сведения о значке ----------
    def перечитай(с, служба, путь):
        ключ = служба + путь
        try:
            свойства = с.шина.позови(служба, путь, 'org.freedesktop.DBus.Properties',
                                     'GetAll', 's', (ЛИЦО_ЗНАЧКА,))[0]
        except Exception:
            с.значки.pop(ключ, None)
            с.сохрани()
            return

        def строка(имя, запас=''):
            з = свойства.get(имя)
            return з if isinstance(з, str) else запас

        картинка = ''
        точки = свойства.get('IconPixmap')
        if точки:
            try:
                ш, в, данные = max(точки, key=lambda п: п[0] * п[1])
                байты = png_из_точек(ш, в, данные)
                if байты:
                    import base64
                    картинка = 'data:image/png;base64,' + base64.b64encode(байты).decode()
            except Exception:
                картинка = ''

        подсказка = свойства.get('ToolTip')
        текст = ''
        if isinstance(подсказка, tuple) and len(подсказка) >= 4:
            текст = подсказка[2] or подсказка[3] or ''
        elif isinstance(подсказка, str):
            текст = подсказка

        с.значки[ключ] = {
            'id': ключ, 'service': служба, 'path': путь,
            'name': строка('Title') or строка('Id') or служба,
            'status': строка('Status', 'Active'),
            'iconName': строка('IconName'),
            'iconData': картинка,
            'tooltip': текст,
            'menu': строка('Menu'),
            'itemIsMenu': bool(свойства.get('ItemIsMenu', False)),
        }
        с.сохрани()

    def убери_службу(с, служба):
        было = len(с.значки)
        с.значки = {к: з for к, з in с.значки.items() if з['service'] != служба}
        if len(с.значки) != было:
            с.сохрани()

    def сохрани(с):
        """Пишем одним куском и подменой: читатель не должен застать середину."""
        видно = [з for з in с.значки.values() if з['status'] != 'Passive']
        try:
            каталог = os.path.dirname(с.файл) or '.'
            врем = tempfile.NamedTemporaryFile('w', encoding='utf-8', dir=каталог,
                                               delete=False, prefix='.glower-tray-')
            json.dump({'items': видно}, врем, ensure_ascii=False)
            врем.close()
            os.chmod(врем.name, 0o600)
            os.replace(врем.name, с.файл)
        except Exception as е:
            print('glower-tray: не выходит записать список (%s)' % е, file=sys.stderr, flush=True)

    # ---------- разговор ----------
    def на_сообщение(с, м):
        поля = м['поля']
        кто = поля.get(7, '')
        лицо, метод, путь = поля.get(2, ''), поля.get(3, ''), поля.get(1, '')

        if м['тип'] == СИГНАЛ and метод == 'NameOwnerChanged':
            имя, _было, стало = (м['тело'] + ['', '', ''])[:3]
            if стало == '':
                с.убери_службу(имя)
            return
        if м['тип'] == СИГНАЛ and лицо == ЛИЦО_ЗНАЧКА:
            с.перечитай(кто, путь)
            return
        if м['тип'] != ВЫЗОВ:
            return

        номер = поля.get(9) or м['номер']
        if лицо == 'org.freedesktop.DBus.Introspectable' and метод == 'Introspect':
            с.шина.ответь(кто, номер, 's', (ОПИСАНИЕ,)); return

        if лицо == 'org.freedesktop.DBus.Properties':
            имя_свойства = м['тело'][1] if len(м['тело']) > 1 else ''
            if метод == 'Get':
                з = {'RegisteredStatusNotifierItems': ('as', list(с.значки.keys())),
                     'IsStatusNotifierHostRegistered': ('b', True),
                     'ProtocolVersion': ('i', 0)}.get(имя_свойства)
                if з is None:
                    с.шина.откажи(кто, номер, 'org.freedesktop.DBus.Error.UnknownProperty',
                                  'нет такого свойства')
                else:
                    с.шина.ответь(кто, номер, 'v', (з,))
            elif метод == 'GetAll':
                с.шина.ответь(кто, номер, 'a{sv}', ({
                    'RegisteredStatusNotifierItems': ('as', list(с.значки.keys())),
                    'IsStatusNotifierHostRegistered': ('b', True),
                    'ProtocolVersion': ('i', 0)},))
            else:
                с.шина.откажи(кто, номер, 'org.freedesktop.DBus.Error.UnknownMethod', 'нет')
            return

        if лицо == ИМЯ_НАБЛЮДАТЕЛЯ:
            if метод == 'RegisterStatusNotifierItem':
                что = м['тело'][0] if м['тело'] else ''
                служба, объект = (кто, что) if что.startswith('/') else (что, '/StatusNotifierItem')
                с.шина.ответь(кто, номер)
                с.перечитай(служба, объект)
                с.шина.сигналь(ПУТЬ_НАБЛЮДАТЕЛЯ, ИМЯ_НАБЛЮДАТЕЛЯ,
                               'StatusNotifierItemRegistered', 's', (служба + объект,))
                return
            if метод == 'RegisterStatusNotifierHost':
                с.шина.ответь(кто, номер)
                с.шина.сигналь(ПУТЬ_НАБЛЮДАТЕЛЯ, ИМЯ_НАБЛЮДАТЕЛЯ, 'StatusNotifierHostRegistered')
                return

        с.шина.откажи(кто, номер, 'org.freedesktop.DBus.Error.UnknownMethod',
                      'лоток такого не умеет: ' + метод)

    def работай(с):
        занято = с.шина.объяви_имя(ИМЯ_НАБЛЮДАТЕЛЯ)
        if занято not in (1, 4):
            print('glower-tray: приёмник значков уже есть — выхожу', file=sys.stderr, flush=True)
            return 0
        # Программы ищут не только наблюдателя, но и приёмника.
        с.шина.объяви_имя('org.kde.StatusNotifierHost-%d' % os.getpid())
        с.шина.слушай("type='signal',interface='org.freedesktop.DBus',member='NameOwnerChanged'")
        с.шина.слушай("type='signal',interface='%s'" % ЛИЦО_ЗНАЧКА)
        с.сохрани()
        print('glower-tray: приёмник значков объявлен, список в %s' % с.файл,
              file=sys.stderr, flush=True)

        while True:
            for м in с.шина.вход:
                с.на_сообщение(м)
            с.шина.вход = []
            м = с.шина.прими()
            if м:
                с.на_сообщение(м)


if __name__ == '__main__':
    try:
        sys.exit(Лоток(Шина()).работай() or 0)
    except KeyboardInterrupt:
        sys.exit(0)
    except Exception as е:
        print('glower-tray: %s' % е, file=sys.stderr, flush=True)
        sys.exit(1)
