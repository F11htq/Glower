# Кнопки окна у всех программ GTK — свернуть, развернуть, закрыть, как в
# Windows и в программах самой системы. Ubuntu по умолчанию оставляет одну
# «закрыть», и Firefox, который рисует верхнюю полосу сам, но кнопки берёт
# отсюда, выглядел не так, как соседние окна.
[org.gnome.desktop.wm.preferences]
button-layout='appmenu:minimize,maximize,close'

# Значки — Adwaita: она стоит в системе всегда, а Yaru, на которую
# указывает Ubuntu, у нас нет, и программы брали значки из запасной темы.
[org.gnome.desktop.interface]
icon-theme='Adwaita'
