<?xml version="1.0"?>
<!--
  Настройки оконного сервера GlowerOS.

  Раньше сеанс держался на cage: он показывает одно окно за раз, и любая
  чужая программа закрывала собой всё, не оставляя пути назад. labwc — это
  настоящий оконный сервер: чужие окна живут рядом с оболочкой, попадают в
  панель задач и переключаются как везде.

  Оболочка — окно с именем glowershell. Оно всегда внизу стопки, без рамки
  и не показывается в чужих переключателях: это рабочий стол, а не окно.
-->
<labwc_config>

  <core>
    <gap>0</gap>
  </core>

  <theme>
    <cornerRadius>10</cornerRadius>
    <font name="sans" size="10" />
  </theme>

  <keyboard>
    <default />
    <!-- Одна клавиша Win — меню программ, как в любой другой системе.
         Ловит её оконный сервер: страница получает клавиши только пока
         она в фокусе, и стоило открыть браузер, как Win уходил ему.

         Эта сборка оконного сервера умеет ловить клавишу только на
         нажатии, а Win приходит первой и в Win+Shift+S, и в Win+D. Чтобы
         меню не выскакивало перед каждым сочетанием, сочетания оставляют
         отметку вторым действием, а меню её ждёт — четверть секунды. -->
    <keybind key="Super_L">
      <action name="Execute" command="glower-menu" />
    </keybind>
    <!-- Super и D возвращают на рабочий стол из любой программы, а окна
         самой системы на столе сворачивают — как в Windows -->
    <keybind key="W-d">
      <action name="Execute" command="glower-menu отмени" />
      <action name="Execute" command="wlrctl toplevel focus app_id:glowershell" />
      <action name="Execute" command="glower-menu клавиша W-d" />
    </keybind>
    <!-- Тем, кто знает, зачем он нужен: настоящий терминал -->
    <keybind key="W-Return">
      <action name="Execute" command="glower-menu отмени" />
      <action name="Execute" command="foot" />
    </keybind>
    <!-- Сочетания, которые нужны и окнам самой системы.

         Параметры, Магазин, Проводник — окна внутри страницы рабочего
         стола, и для оконного сервера все они одно окно, glowershell.
         Стандартные Alt+F4 и Alt+Tab он забирал себе раньше страницы:
         Alt+F4 просил закрыться весь стол (стол отказывается), Alt+Tab
         перебирал только чужие окна. Человек жал Alt+F4 на открытых
         Параметрах — и ничего не происходило.

         Теперь на столе сервер передаёт сочетание странице, а она решает,
         какое из её окон закрыть или поднять. В чужих окнах всё как
         прежде. -->
    <keybind key="A-F4">
      <action name="If">
        <query identifier="glowershell" />
        <then><action name="Execute" command="glower-menu клавиша A-F4" /></then>
        <else>
          <action name="Execute" command="glower-menu отмени" />
          <action name="Close" />
        </else>
      </action>
    </keybind>
    <keybind key="W-q">
      <action name="If">
        <query identifier="glowershell" />
        <then><action name="Execute" command="glower-menu клавиша W-q" /></then>
        <else>
          <action name="Execute" command="glower-menu отмени" />
          <action name="Close" />
        </else>
      </action>
    </keybind>
    <keybind key="A-Tab">
      <action name="If">
        <query identifier="glowershell" />
        <then><action name="Execute" command="glower-menu клавиша A-Tab" /></then>
        <else>
          <action name="NextWindow" />
        </else>
      </action>
    </keybind>
    <keybind key="W-Left">
      <action name="If">
        <query identifier="glowershell" />
        <then><action name="Execute" command="glower-menu клавиша W-Left" /></then>
        <else>
          <action name="Execute" command="glower-menu отмени" />
          <action name="SnapToEdge" direction="left" />
        </else>
      </action>
    </keybind>
    <keybind key="W-Right">
      <action name="If">
        <query identifier="glowershell" />
        <then><action name="Execute" command="glower-menu клавиша W-Right" /></then>
        <else>
          <action name="Execute" command="glower-menu отмени" />
          <action name="SnapToEdge" direction="right" />
        </else>
      </action>
    </keybind>
    <keybind key="W-Up">
      <action name="If">
        <query identifier="glowershell" />
        <then><action name="Execute" command="glower-menu клавиша W-Up" /></then>
        <else>
          <action name="Execute" command="glower-menu отмени" />
          <action name="SnapToEdge" direction="up" />
        </else>
      </action>
    </keybind>
    <keybind key="W-Down">
      <action name="If">
        <query identifier="glowershell" />
        <then><action name="Execute" command="glower-menu клавиша W-Down" /></then>
        <else>
          <action name="Execute" command="glower-menu отмени" />
          <action name="SnapToEdge" direction="down" />
        </else>
      </action>
    </keybind>
    <!-- Alt со стрелками по умолчанию двигает окно к краю экрана. Но это
         же сочетание в любом браузере и в Проводнике значит «назад» и
         «вперёд» — и до программы оно не доходило. Отдаём его программам.
         Alt+F3 звал программу запуска, которой в системе нет. -->
    <keybind key="A-Left"><action name="None" /></keybind>
    <keybind key="A-Right"><action name="None" /></keybind>
    <keybind key="A-Up"><action name="None" /></keybind>
    <keybind key="A-Down"><action name="None" /></keybind>
    <keybind key="A-F3"><action name="None" /></keybind>
    <!-- Рабочие столы с клавиатуры — теми же сочетаниями, что в GNOME:
         Win с Page Up / Page Down и Ctrl+Alt со стрелками. Первым
         действием всюду отметка: иначе Win, пришедшая первой в сочетании,
         успеет открыть меню программ. -->
    <keybind key="W-Prior">
      <action name="Execute" command="glower-menu отмени" />
      <action name="Execute" command="glower-desk назад" />
    </keybind>
    <keybind key="W-Next">
      <action name="Execute" command="glower-menu отмени" />
      <action name="Execute" command="glower-desk вперёд" />
    </keybind>
    <keybind key="C-A-Left">
      <action name="Execute" command="glower-desk назад" />
    </keybind>
    <keybind key="C-A-Right">
      <action name="Execute" command="glower-desk вперёд" />
    </keybind>
    <!-- Снимок экрана. Сочетания держит оконный сервер, а не оболочка:
         страница получает клавиши, только пока она в фокусе, и стоило
         открыть любую программу, как Win+Shift+S уходил ей. -->
    <keybind key="W-S-s">
      <action name="Execute" command="glower-menu отмени" />
      <action name="Execute" command="glower-shot область" />
    </keybind>
    <keybind key="Print">
      <action name="Execute" command="glower-shot экран" />
    </keybind>
    <!-- Привычка из Windows: Print со сдвигом тоже про область -->
    <keybind key="S-Print">
      <action name="Execute" command="glower-shot область" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>

  <windowRules>
    <windowRule identifier="glowershell">
      <!-- Оболочку намеренно не прячем от протокола управления окнами:
           иначе к ней нельзя вернуться ни клавишами, ни панелью задач.
           Из списка окон её убирает сама оболочка — она знает своё имя. -->
      <serverDecoration>no</serverDecoration>
      <action name="ToggleAlwaysOnBottom" />
    </windowRule>
  </windowRules>

</labwc_config>
