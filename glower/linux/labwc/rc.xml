<?xml version="1.0"?>
<!--
  Настройки оконного сервера GlowerOS.

  Рабочий стол, панель, док и меню — поверхности слоёв одной программы,
  glower-panel: оконный сервер ставит их ниже и выше окон сам, и окном
  среди окон ни одна из них не числится. Поэтому сочетания здесь простые:
  закрыть, перебрать, прижать к краю — обычные действия labwc над
  обычными окнами. Окна системы (Параметры, Проводник, Магазин) — тоже
  настоящие окна, и Alt+F4 закрывает их так же, как любые другие.
-->
<labwc_config>

  <core>
    <gap>0</gap>
  </core>

  <theme>
    <cornerRadius>10</cornerRadius>
    <font name="sans" size="10" />
  </theme>

  <!-- Рабочие столы — настоящие, оконного сервера: окна других столов он
       прячет сам. Столов четыре, сколько из них видно — решает человек в
       Параметрах. Табличку с именем стола при переходе не показываем:
       панель и так знает, где мы. -->
  <desktops>
    <popupTime>0</popupTime>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
  </desktops>

  <keyboard>
    <default />
    <!-- Одна клавиша Win — меню программ, как в любой другой системе.

         Эта сборка оконного сервера умеет ловить клавишу только на
         нажатии, а Win приходит первой и в Win+Shift+S, и в Win+D. Чтобы
         меню не выскакивало перед каждым сочетанием, сочетания оставляют
         отметку вторым действием, а меню её ждёт — четверть секунды. -->
    <keybind key="Super_L">
      <action name="Execute" command="glower-menu" />
    </keybind>
    <!-- Просмотр задач: все окна крупно и рабочие столы -->
    <keybind key="W-Tab">
      <action name="Execute" command="glower-menu отмени" />
      <action name="Execute" command="glower-menu задачи" />
    </keybind>
    <!-- Super и D — на рабочий стол из любой программы, второй раз —
         окна обратно, как в Windows -->
    <keybind key="W-d">
      <action name="Execute" command="glower-menu отмени" />
      <action name="Execute" command="glower-menu клавиша W-d" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="glower-menu замок" />
    </keybind>
    <!-- Программы системы — привычными сочетаниями -->
    <keybind key="W-e">
      <action name="Execute" command="glower-menu отмени" />
      <action name="Execute" command="glower-files" />
    </keybind>
    <keybind key="W-i">
      <action name="Execute" command="glower-menu отмени" />
      <action name="Execute" command="glower-settings" />
    </keybind>
    <keybind key="C-S-Escape">
      <action name="Execute" command="glower-taskmgr" />
    </keybind>
    <keybind key="W-Return">
      <action name="Execute" command="glower-menu отмени" />
      <action name="Execute" command="foot" />
    </keybind>
    <!-- Окна -->
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <keybind key="W-q">
      <action name="Execute" command="glower-menu отмени" />
      <action name="Close" />
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="W-Left">
      <action name="Execute" command="glower-menu отмени" />
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-Right">
      <action name="Execute" command="glower-menu отмени" />
      <action name="SnapToEdge" direction="right" />
    </keybind>
    <keybind key="W-Up">
      <action name="Execute" command="glower-menu отмени" />
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-Down">
      <action name="Execute" command="glower-menu отмени" />
      <action name="Iconify" />
    </keybind>
    <!-- Alt со стрелками по умолчанию двигает окно к краю экрана. Но это
         же сочетание в любом браузере и в Проводнике значит «назад» и
         «вперёд» — и до программы оно не доходило. Отдаём его программам.
         Alt+F3 звал программу запуска, которой в системе нет. -->
    <keybind key="A-Left"><action name="None" /></keybind>
    <keybind key="A-Right"><action name="None" /></keybind>
    <keybind key="A-Up"><action name="None" /></keybind>
    <keybind key="A-Down"><action name="None" /></keybind>
    <keybind key="A-F3"><action name="None" /></keybind>
    <!-- Рабочие столы с клавиатуры — теми же сочетаниями, что в GNOME:
         Win с Page Up / Page Down и Ctrl+Alt со стрелками. Решает панель:
         она знает, сколько столов заведено. -->
    <keybind key="W-Prior">
      <action name="Execute" command="glower-menu отмени" />
      <action name="Execute" command="glower-desk назад" />
    </keybind>
    <keybind key="W-Next">
      <action name="Execute" command="glower-menu отмени" />
      <action name="Execute" command="glower-desk вперёд" />
    </keybind>
    <keybind key="C-A-Left">
      <action name="Execute" command="glower-desk назад" />
    </keybind>
    <keybind key="C-A-Right">
      <action name="Execute" command="glower-desk вперёд" />
    </keybind>
    <!-- Служебные сочетания: ими панель просит оконный сервер перейти на
         стол или отправить туда окно. Других способов попросить об этом
         снаружи у этой сборки labwc нет. Руками их никто не нажмёт. -->
    <keybind key="W-C-A-F1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-C-A-F2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-C-A-F3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-C-A-F4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-C-A-S-F1"><action name="SendToDesktop" to="1" follow="no" /></keybind>
    <keybind key="W-C-A-S-F2"><action name="SendToDesktop" to="2" follow="no" /></keybind>
    <keybind key="W-C-A-S-F3"><action name="SendToDesktop" to="3" follow="no" /></keybind>
    <keybind key="W-C-A-S-F4"><action name="SendToDesktop" to="4" follow="no" /></keybind>
    <!-- Клавиши мультимедиа — проигрывателю, который сейчас играет (MPRIS);
         громкость и яркость — системе напрямую, из любой программы -->
    <keybind key="XF86AudioPlay"><action name="Execute" command="glower-menu медиа PlayPause" /></keybind>
    <keybind key="XF86AudioPause"><action name="Execute" command="glower-menu медиа PlayPause" /></keybind>
    <keybind key="XF86AudioNext"><action name="Execute" command="glower-menu медиа Next" /></keybind>
    <keybind key="XF86AudioPrev"><action name="Execute" command="glower-menu медиа Previous" /></keybind>
    <keybind key="XF86AudioStop"><action name="Execute" command="glower-menu медиа Stop" /></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" /></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="brightnessctl -q set 5%+" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="brightnessctl -q set 5%-" /></keybind>
    <!-- Снимок экрана. Сочетания держит оконный сервер: клавиши достаются
         окну в фокусе, и иначе Win+Shift+S уходил бы любой программе. -->
    <keybind key="W-S-s">
      <action name="Execute" command="glower-menu отмени" />
      <action name="Execute" command="glower-shot область" />
    </keybind>
    <keybind key="Print">
      <action name="Execute" command="glower-shot экран" />
    </keybind>
    <!-- Привычка из Windows: Print со сдвигом тоже про область -->
    <keybind key="S-Print">
      <action name="Execute" command="glower-shot область" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>

</labwc_config>
