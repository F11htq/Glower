#!/bin/sh
# Просит оболочку снять экран.
#
# Сочетания клавиш ловит оконный сервер, а не страница: страница получает
# клавиши, только пока оболочка в фокусе, и стоило открыть любую программу,
# как Win+Shift+S уходил ей. Поэтому сочетание висит на оконном сервере, а
# он зовёт эту программу.
#
# Сама она ничего не снимает — только передаёт просьбу оболочке, у которой
# уже есть и окно для разметки, и буфер обмена, и папка для снимков. Имя
# файла и переменные латиницей: dash кириллицу в именах не принимает.
set -eu

MODE="${1:-область}"
case "$MODE" in
  область|экран) : ;;
  *) echo "как звать: glower-shot [область|экран]" >&2; exit 2 ;;
esac

PORT="${GLOWER_PORT:-8123}"
URL="http://127.0.0.1:$PORT/rpc"

# Кавычки внутри JSON собираем сами: сюда приходит только одно из двух слов,
# проверенных выше, так что подставлять нечего.
BODY="{\"method\":\"ui.say\",\"params\":{\"тема\":\"снимок\",\"что\":\"$MODE\"}}"

if command -v curl >/dev/null 2>&1; then
  curl -sf -m 5 -X POST -H 'Content-Type: application/json' -d "$BODY" "$URL" >/dev/null || {
    echo "оболочка не отвечает — снимок сделать некому" >&2; exit 1; }
else
  echo "в системе нет curl — сказать оболочке нечем" >&2; exit 1
fi
