#!/bin/sh
# ==========================================================================
#  Экран входа GlowerOS
#
#  Запускается службой greetd до всякого рабочего стола и от имени особого
#  пользователя без прав. Показывает свой экран входа (glower-login) —
#  тот же, что замок по Win+L: список людей и вопрос о пароле.
#
#  Пароль проверяет не он: ответ уходит greetd, а тот спрашивает саму
#  систему через PAM и заводит настоящий сеанс. Так и должно быть — экран
#  входа не может решать, кого пускать.
# ==========================================================================
set -u

PORT="${GLOWER_GREETER_PORT:-8124}"
UI="${GLOWER_UI:-/usr/share/glower/ui}"
LOG=/tmp/glower-greeter.log

# Своя папка на время экрана входа: у этого пользователя нет своего дома
HOMEDIR="${XDG_RUNTIME_DIR:-/tmp}/glower-greeter"
mkdir -p "$HOMEDIR" 2>/dev/null || true

# Агент экрана входа: без системного слоя и без прав — ему нужен только
# разговор с greetd и список людей из /etc/passwd.
# Экрану входа нужно ровно одно право — выключить машину. Кнопки питания
# стоят прямо на нём, и человек вправе выключить компьютер, не входя в
# систему: так везде.
#
# Без этого права метод sys.power у агента даже не появляется, и кнопка
# отвечала честно, но бестолково: «Система отказала: нет такого метода».
# Выключить машину из экрана входа было нельзя вовсе.
#
# Больше не даём ничего. Открывать файлы, запускать программы и ставить
# систему тому, кто ещё не вошёл, незачем.
node "$UI/agent/server.mjs" --port "$PORT" --root "$HOMEDIR" --allow-power >>"$LOG" 2>&1 &
AGENT=$!
LABWC=""
trap 'kill $AGENT $LABWC 2>/dev/null' EXIT INT TERM

i=0
while [ $i -lt 50 ]; do
  curl -sf "http://localhost:$PORT/" >/dev/null 2>&1 && break
  i=$((i+1)); sleep 0.2
done

mkdir -p "$HOMEDIR/.local/share/glower"
# Экран входа живёт, пока человек не вошёл. Упал — поднимаем снова: войти
# в систему человек должен при любой беде. Пять падений за полминуты — это
# уже не случайность, тогда сдаёмся, и служба входа начнёт всё сначала.
# $GLOWER_X_SIZE — только под X-сервером: растянуть вложенный экран.
cat > "$HOMEDIR/пуск.sh" <<STARTUP
#!/bin/sh
command -v wlr-randr >/dev/null && [ -n "\$GLOWER_X_SIZE" ] && \\
  wlr-randr --output X11-1 --custom-mode "\$GLOWER_X_SIZE" >/dev/null 2>&1
falls=0
since=\$(date +%s)
while :; do
  GLOWER_URL="http://localhost:$PORT/" /usr/bin/glower-login && break
  now=\$(date +%s)
  if [ \$((now - since)) -gt 30 ]; then falls=0; since=\$now; fi
  falls=\$((falls + 1))
  [ \$falls -ge 5 ] && break
  sleep 1
done
labwc -e >/dev/null 2>&1 || true
STARTUP
chmod +x "$HOMEDIR/пуск.sh"

# На машинах без видеоускорения (виртуалки, старое железо) wlroots
# отказывается рисовать программно, пока его об этом не попросят прямо.
export WLR_RENDERER_ALLOW_SOFTWARE=1

# Оконный сервер запускаем в стороне и ждём его отдельно. Разница не
# косметическая: пока оболочка стояла на переднем плане, сигнал «закончили»
# от службы входа доходил только до сценария и лежал без движения до её
# возвращения. Экран входа оставался на экране поверх уже начавшегося
# сеанса — человек вводил пароль и продолжал смотреть на тот же экран.
# Ожидание сигнала прерывает, обработчик снимает и сервер, и агента.

# На машине, где ядро не управляет видеокартой, Wayland прямо на ней не
# поднимется: ему нужен узел /dev/dri, а его там нет. Тогда тот же labwc
# идёт внутри X-сервера, который рисует простым способом.
LABWC_CFG="${GLOWER_LABWC:-/usr/share/glower/labwc-вход}"
if ls /dev/dri/card* >/dev/null 2>&1; then
  HOME="$HOMEDIR" labwc -C "$LABWC_CFG" -s "$HOMEDIR/пуск.sh" >>"$LOG" 2>&1 &
else
  cat > "$HOMEDIR/.xinitrc" <<XRC
#!/bin/sh
GLOWER_X_SIZE=\$(xdpyinfo 2>/dev/null | awk '/dimensions:/ { print \$2; exit }')
export GLOWER_X_SIZE
WLR_BACKENDS=x11 WLR_RENDERER=pixman \\
  exec labwc -C "$LABWC_CFG" -s "$HOMEDIR/пуск.sh"
XRC
  chmod +x "$HOMEDIR/.xinitrc"
  HOME="$HOMEDIR" startx "$HOMEDIR/.xinitrc" -- :0 vt1 -nolisten tcp >>"$LOG" 2>&1 &
fi
LABWC=$!
wait $LABWC
