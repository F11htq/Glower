#!/bin/sh
# ==========================================================================
#  Переключение рабочих столов с клавиатуры — как в GNOME.
#
#  Столы живут в оболочке, а клавиши достаются окну в фокусе: из браузера
#  или терминала нажатие до оболочки не доходит вовсе. Поэтому сочетания
#  держит оконный сервер, а он зовёт эту программу — она только передаёт
#  просьбу, как glower-shot и glower-menu.
#
#      glower-desk вперёд | назад | <номер>
#
#  Имена переменных латиницей: dash кириллицу в именах не принимает.
# ==========================================================================
set -eu

WHERE="${1:-вперёд}"
case "$WHERE" in
  вперёд|назад|next|prev) ;;
  [0-9]|[0-9][0-9]) ;;
  *) echo "как звать: glower-desk [вперёд|назад|номер]" >&2; exit 2 ;;
esac
case "$WHERE" in next) WHERE=вперёд ;; prev) WHERE=назад ;; esac

PORT="${GLOWER_PORT:-8123}"
BODY="{\"method\":\"ui.say\",\"params\":{\"тема\":\"стол\",\"что\":\"$WHERE\"}}"

command -v curl >/dev/null 2>&1 || { echo "в системе нет curl" >&2; exit 1; }
curl -sf -m 5 -X POST -H 'Content-Type: application/json' -d "$BODY" \
  "http://127.0.0.1:$PORT/rpc" >/dev/null || {
  echo "оболочка не отвечает — переключать некому" >&2; exit 1; }
