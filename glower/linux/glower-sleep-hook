#!/bin/sh
# ==========================================================================
#  Перед сном и после него — systemd зовёт всё из system-sleep
#  с доводами «pre|post suspend|hibernate|…».
#
#  Перед сном: тем, кому человек (или агент за него) запретил будить
#  машину, запрет ставится заново — после перезагрузки и для заново
#  воткнутого устройства прошивка снова разрешает (см. glower-sleep).
#
#  Закрытый драйвер Broadcom (wl) известен тем, что не даёт машине уснуть
#  или будит её сразу: карта отказывается засыпать. Лечится одним — на
#  время сна драйвер выгрузить, после — загрузить; NetworkManager
#  подключится к сети сам.
#
#  Имена латиницей: dash кириллицу в именах не принимает.
# ==========================================================================
PATH=/usr/sbin:/usr/bin:/sbin:/bin
FLAG=/run/glower-sleep-wl

case "${1:-}" in
  pre)
    [ -x /usr/bin/glower-sleep ] && /usr/bin/glower-sleep apply
    if grep -q '^wl ' /proc/modules 2>/dev/null; then
      modprobe -r wl 2>/dev/null && : > "$FLAG"
    fi
    ;;
  post)
    if [ -e "$FLAG" ]; then
      rm -f "$FLAG"
      modprobe wl 2>/dev/null
    fi
    ;;
esac
exit 0
