#!/bin/sh
# ==========================================================================
#  Починка того, что человек чинить не должен
#
#  Запускается от root через sudo и только с одним из известных ключей.
#  Никаких произвольных команд: список починок закрыт и виден целиком.
#  Каждая печатает, что получилось, — оболочке нужен ответ, а не молчание.
# ==========================================================================
set -eu

case_name="${1:-}"

case "$case_name" in
  песочница)
    # Программы из Flathub работают в песочнице, а песочнице нужны
    # пространства имён пользователя. В Ubuntu 24.04 они закрыты по
    # умолчанию, и программа не доходит даже до запуска.
    sysctl -q -w kernel.apparmor_restrict_unprivileged_userns=0 2>/dev/null || true
    sysctl -q -w kernel.unprivileged_userns_clone=1 2>/dev/null || true
    printf -- '-kernel.apparmor_restrict_unprivileged_userns=0\n-kernel.unprivileged_userns_clone=1\n' \
      > /etc/sysctl.d/60-glower-userns.conf
    # Профиль AppArmor может держать запрет и помимо переключателя: если
    # система умеет его отключать для песочницы, пользуемся этим.
    if [ -e /sys/kernel/security/apparmor/profiles ] && command -v aa-disable >/dev/null 2>&1; then
      aa-disable /etc/apparmor.d/bwrap-userns-restrict >/dev/null 2>&1 || true
      aa-disable /etc/apparmor.d/unprivileged_userns >/dev/null 2>&1 || true
    fi
    value="$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null || echo нет)"
    echo "песочница: ограничение=$value"
    ;;
  язык)
    # Локаль для программ Linux: без неё Firefox, Thunar и прочие говорят
    # по-английски, даже когда сама система уже на другом языке. Имя
    # локали — только из закрытого списка: никаких произвольных строк.
    loc="${2:-}"
    case "$loc" in
      ru_RU.UTF-8|en_US.UTF-8|en_GB.UTF-8|uk_UA.UTF-8|be_BY.UTF-8|kk_KZ.UTF-8|de_DE.UTF-8|fr_FR.UTF-8|es_ES.UTF-8|it_IT.UTF-8|pt_BR.UTF-8|pl_PL.UTF-8|tr_TR.UTF-8) ;;
      *) echo "неизвестная локаль: $loc" >&2; exit 2 ;;
    esac
    locale-gen "$loc" >/dev/null 2>&1 || { echo "локаль $loc не создалась" >&2; exit 1; }
    echo "язык: $loc готова"
    ;;
  *)
    echo "неизвестная починка: $case_name" >&2
    exit 2
    ;;
esac
