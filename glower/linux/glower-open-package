#!/bin/sh
# ==========================================================================
#  Открыть файл-установщик в системе
#
#  На этот файл система выходит, когда человек щёлкает по скачанному .deb,
#  .flatpakref или программе одним файлом (AppImage). Сами мы ничего не
#  ставим и не запускаем: передаём путь оболочке, а она показывает, что за
#  программа, и спрашивает согласия. Молча, без спроса, нельзя — это чужой
#  файл из интернета.
# ==========================================================================
set -u
ПОРТ="${GLOWER_PORT:-8123}"
ФАЙЛ="$1"

[ -n "${ФАЙЛ:-}" ] || { echo "нужен путь к файлу" >&2; exit 2; }
# Путь делаем полным: оболочка получает файл, а не догадку о нём
случай=$(cd "$(dirname -- "$ФАЙЛ")" 2>/dev/null && pwd)
[ -n "$случай" ] || { echo "такого файла нет: $ФАЙЛ" >&2; exit 2; }
ПОЛНЫЙ="$случай/$(basename -- "$ФАЙЛ")"

# Строку в JSON кладём через python: путь может содержать кавычки и пробелы
ТЕЛО=$(python3 - "$ПОЛНЫЙ" <<'PY'
import json, sys
print(json.dumps({'method': 'ui.say',
                  'params': {'тема': 'файл-установщик', 'что': {'путь': sys.argv[1]}}},
                 ensure_ascii=False))
PY
)

if curl -sf --max-time 5 -X POST "http://localhost:$ПОРТ/rpc" \
     -H 'Content-Type: application/json' --data "$ТЕЛО" >/dev/null; then
  exit 0
fi

echo "Оболочка GlowerOS не отвечает — открыть установку нечем." >&2
exit 1
