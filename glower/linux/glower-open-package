#!/bin/sh
# ==========================================================================
#  Открыть файл-установщик в системе
#
#  На этот файл система выходит, когда человек щёлкает по скачанному .deb,
#  .flatpakref или программе одним файлом (AppImage). Сами мы ничего не
#  ставим и не запускаем: передаём путь оболочке, а она показывает, что за
#  программа, и спрашивает согласия. Молча, без спроса, нельзя — это чужой
#  файл из интернета.
#
#  Имена переменных здесь только латиницей, и это не вкусовщина: /bin/sh
#  кириллицу в именах не понимает вовсе и падает на первой же строке. Из-за
#  этого двойной щелчок по скачанному .deb молча не делал ничего — сценарий
#  умирал раньше, чем успевал что-либо сказать.
# ==========================================================================
set -u
PORT="${GLOWER_PORT:-8123}"
FILE="$1"

[ -n "${FILE:-}" ] || { echo "нужен путь к файлу" >&2; exit 2; }
# Путь делаем полным: оболочка получает файл, а не догадку о нём
DIR=$(cd "$(dirname -- "$FILE")" 2>/dev/null && pwd)
[ -n "$DIR" ] || { echo "такого файла нет: $FILE" >&2; exit 2; }
FULL="$DIR/$(basename -- "$FILE")"

# Строку в JSON кладём через python: путь может содержать кавычки и пробелы
BODY=$(python3 - "$FULL" <<'PY'
import json, sys
print(json.dumps({'method': 'ui.say',
                  'params': {'тема': 'файл-установщик', 'что': {'путь': sys.argv[1]}}},
                 ensure_ascii=False))
PY
)

if curl -sf --max-time 5 -X POST "http://localhost:$PORT/rpc" \
     -H 'Content-Type: application/json' --data "$BODY" >/dev/null; then
  exit 0
fi

echo "Оболочка GlowerOS не отвечает — открыть установку нечем." >&2
exit 1
